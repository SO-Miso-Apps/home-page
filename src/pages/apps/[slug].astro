---
import { LiveEntryNotFoundError } from "astro/content/runtime";
import { decodeSlug, getSeoMeta } from "emdash";
import type { App } from "../../../emdash-env";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import AppMark from "../../components/AppMark.astro";
import AppCard from "../../components/AppCard.astro";
import CtaPanel from "../../components/CtaPanel.astro";
import FeatureGrid from "../../components/FeatureGrid.astro";
import ScreenshotGallery from "../../components/ScreenshotGallery.astro";
import { getLang, localizeHref, splitLang } from "../../i18n";
import { getLocalizedEntry } from "../../lib/content";
import { getListing, sizedIcon } from "../../lib/app-store";
import { getRating } from "../../lib/ratings";
import { getLocalizedCollection } from "../../lib/content";

const lang = getLang(Astro.locals);
const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite(localizeHref("/404", lang));
// Translations share the English slug; an app nobody has translated yet falls
// back to its English entry rather than a 404.
const { entry: app, error, isPreview, cacheHint } = await getLocalizedEntry("apps", slug, lang);

if (error) {
  // Astro live collections surface a missing entry as LiveEntryNotFoundError
  // rather than a null entry, so a content miss must answer 404, not 500.
  // rewrite (not redirect) so the URL itself serves the 404 status.
  if (LiveEntryNotFoundError.is(error)) return Astro.rewrite(localizeHref("/404", lang));
  console.error("Failed to load app:", error);
  return new Response("Unable to load app", { status: 500 });
}
if (!app) return Astro.rewrite(localizeHref("/404", lang));
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const data = app.data;
// A translation's id is "vi/<slug>"; the slug is the id in every language, so
// the mark's seed and the sibling filter key on it.
const appId = slug;
const listing = getListing(data.app_store_url);
const listingIcon = listing?.icon;
// Up to three listing screenshots fan out behind the icon in the hero.
const heroShots = (listing?.media ?? []).flatMap((item) => (item.type === "image" ? [item] : [])).slice(0, 3);

// Cross-links to the rest of the catalog. Its cache hint is registered too —
// Astro accumulates tags across set() calls, so publishing an entry also
// purges the pages that list it.
const { entries: siblings, error: siblingsError, cacheHint: siblingsHint } =
  await getLocalizedCollection<"apps", App>("apps", { orderBy: { sort_order: "asc" } }, lang);
const otherApps = siblingsError ? [] : siblings.filter((entry) => entry.id !== appId);
const pagePath = localizeHref(splitLang(Astro.url.pathname).path, lang);
if (Astro.cache?.enabled) Astro.cache.set(siblingsHint);
if (siblingsError) console.error("Failed to load sibling apps:", siblingsError);

const seo = getSeoMeta(app, {
  siteTitle: "Miso Apps",
  siteUrl: Astro.site?.toString() ?? Astro.url.origin,
  path: Astro.url.pathname,
});

// getSeoMeta resolves its title from the SEO panel or `data.title`; apps have
// neither, so seo.title is "" here — prefer it only when non-empty.
const title = seo.title || data.seo_title || data.name;

const ogImageSrc = data.og_image?.src ?? data.icon?.src ?? undefined;

// getSeoMeta returns description null for App entries (no SEO panel, no
// excerpt), so its `?? tagline` chain never sees the entry's own
// seo_description. Read it explicitly; tagline is the fallback.
const description = data.seo_description || data.tagline;

const jsonld: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: data.name,
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description: data.tagline,
  url: new URL(pagePath, Astro.site ?? Astro.url.origin).toString(),
  inLanguage: lang,
  offers: {
    "@type": "Offer",
    url: data.pricing_url ?? data.app_store_url,
  },
};
// Synced from the listing (see src/lib/ratings.ts); null until the app has a review.
const appRating = getRating(app);
if (appRating) {
  jsonld.aggregateRating = {
    "@type": "AggregateRating",
    ratingValue: appRating.value,
    reviewCount: appRating.count,
  };
}

const ctaHref = data.pricing_url ?? data.app_store_url;

const copy = {
  en: {
    preview: "This is an unpublished preview.",
    install: "Install on the App Store",
    pricing: "View pricing",
    reviews: (n: number) => `${n} ${n === 1 ? "review" : "reviews"} on the Shopify App Store`,
    stars: (r: string) => `${r} out of 5 stars`,
    read: "Read reviews",
    icon: `${data.name} icon`,
    more: "More of our apps",
    ctaEyebrow: "Try it",
    ctaTitle: `Try ${data.name} on your store`,
    ctaBody: "Install from the Shopify App Store and set it up in one sitting.",
    seePricing: "See pricing",
  },
  vi: {
    preview: "Đây là bản xem trước chưa xuất bản.",
    install: "Cài từ App Store",
    pricing: "Xem bảng giá",
    reviews: (n: number) => `${n} đánh giá trên Shopify App Store`,
    stars: (r: string) => `${r} trên 5 sao`,
    read: "Đọc đánh giá",
    icon: `Biểu tượng ${data.name}`,
    more: "Các app khác của chúng tôi",
    ctaEyebrow: "Dùng thử",
    ctaTitle: `Thử ${data.name} trên cửa hàng của bạn`,
    ctaBody: "Cài từ Shopify App Store, thiết lập vài phút là chạy.",
    seePricing: "Xem bảng giá",
  },
}[lang];
---

<Base title={title} description={description} image={seo.ogImage ?? ogImageSrc} canonical={seo.canonical ?? undefined} robots={seo.robots ?? undefined}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  {isPreview && <p class="container preview-note">{copy.preview}</p>}

  <section class="hero" data-hero>
    <div class="hero__panel tone-night">
      <div class="hero__copy">
        {
          data.badge && (
            <span class="hero__badge" data-hero-item>
              {data.badge}
            </span>
          )
        }
        <h1 data-hero-item>{data.name}</h1>
        <p class="hero__lede" data-hero-item>{data.tagline}</p>

        <div class="hero__actions" data-hero-item>
          <a class="btn btn--brand btn--lg" href={data.app_store_url} target="_blank" rel="noopener noreferrer">
            {copy.install}
            <svg class="btn__arrow" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" focusable="false">
              <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          {
            data.pricing_url && (
              <a class="btn btn--outline btn--lg" href={data.pricing_url} target="_blank" rel="noopener noreferrer">
                {copy.pricing}
              </a>
            )
          }
        </div>

        {
          appRating && (
            <div class="rating" data-hero-item>
              <span class="rating__value num">{appRating.value.toFixed(1)}</span>
              <span class="rating__body">
                <span class="rating__stars" role="img" aria-label={copy.stars(appRating.value.toFixed(1))}>
                  {Array.from({ length: 5 }, (_, index) => (
                    <svg viewBox="0 0 16 16" width="15" height="15" class:list={[index < Math.round(appRating.value) ? "on" : "off"]} aria-hidden="true" focusable="false">
                      <path d="M8 1.6l1.9 3.9 4.3.6-3.1 3 .7 4.3L8 11.4l-3.8 2 .7-4.3-3.1-3 4.3-.6L8 1.6Z" />
                    </svg>
                  ))}
                </span>
                <a class="rating__meta" href={`${data.app_store_url.replace(/[?#].*$/, "").replace(/\/+$/, "")}/reviews`} target="_blank" rel="noopener noreferrer">
                  {copy.reviews(appRating.count)}
                  <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false">
                    <path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              </span>
            </div>
          )
        }
      </div>

      {/* Decorative: the listing's own screenshots fanned out behind the icon. */}
      <div class:list={["hero__art", { "hero__art--solo": heroShots.length === 0 }]} data-hero-art>
        {heroShots.length > 0 && (
          <div class="hero__shots" aria-hidden="true">
            {heroShots.map((shot) => (
              <img src={shot.src} width="1600" height="900" alt="" decoding="async" />
            ))}
          </div>
        )}
        <div class="hero__mark" data-float>
          {
            data.icon ? (
              <Image image={data.icon} width={128} height={128} alt={copy.icon} />
            ) : listingIcon ? (
              <img src={sizedIcon(listingIcon, 256)} width="128" height="128" alt={copy.icon} />
            ) : (
              <AppMark seed={appId} size={128} />
            )
          }
        </div>
      </div>
    </div>
  </section>

  {
    data.hero && (
      <section class="section section--tight">
        <div class="container container--narrow prose" data-reveal>
          <PortableText value={data.hero} />
        </div>
      </section>
    )
  }

  <FeatureGrid features={data.features} />
  <ScreenshotGallery screenshots={data.screenshots} appStoreUrl={data.app_store_url} appName={data.name} />

  {
    otherApps.length > 0 && (
      <section class="section" aria-labelledby="more-title">
        <div class="container">
          <h2 id="more-title" class="more__title" data-reveal>
            {copy.more}
          </h2>
          <ul class="more">
            {otherApps.map((entry, index) => (
              <li data-reveal>
                <AppCard app={entry} tone={(["tint", "night", "brand", "mist"] as const)[index % 4]} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <CtaPanel
    eyebrow={copy.ctaEyebrow}
    title={copy.ctaTitle}
    body={copy.ctaBody}
    primary={{ label: copy.install, href: data.app_store_url, external: true }}
    secondary={{ label: copy.seePricing, href: ctaHref, external: true }}
  />
</Base>

<style>
  .preview-note {
    color: var(--brand-ink);
    padding-top: 1.5rem;
    font-size: 0.875rem;
  }

  /* --- Hero: the home page's night panel, with the listing behind the icon */
  .hero {
    padding-top: clamp(0.5rem, 1.5vw, 1rem);
  }

  .hero__panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-inline: clamp(0.5rem, 1.5vw, 1.25rem);
    border-radius: var(--r-2xl);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(1.1rem, 2vw, 1.5rem);
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1.25rem, 5vw, 4.5rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .hero__badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--night-accent);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hero__badge::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }

  h1 {
    font-size: var(--step-5);
    letter-spacing: var(--track-hero);
    color: var(--night-ink);
    max-width: 16ch;
  }

  .hero__lede {
    color: var(--tone-muted);
    font-size: var(--step-1);
    line-height: 1.65;
    max-width: 48ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .btn--outline {
    background: transparent;
    color: var(--night-ink);
    border-color: color-mix(in oklab, var(--night-ink) 26%, transparent);
  }

  .btn--outline:hover {
    border-color: color-mix(in oklab, var(--night-ink) 60%, transparent);
    transform: translateY(-1px);
  }

  /* Rating: the number large, stars and the review link stacked beside it. */
  .rating {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding-top: 1.25rem;
    margin-top: 0.25rem;
    border-top: 1px solid color-mix(in oklab, var(--night-ink) 14%, transparent);
  }

  .rating__value {
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--night-ink);
  }

  .rating__body {
    display: grid;
    gap: 0.3rem;
  }

  .rating__stars {
    display: inline-flex;
    gap: 2px;
  }

  .rating__stars svg {
    fill: color-mix(in oklab, var(--night-ink) 22%, transparent);
  }

  .rating__stars svg.on {
    fill: var(--night-accent);
  }

  .rating__meta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.875rem;
    color: var(--tone-muted);
    text-decoration: none;
    transition: color var(--dur-2) var(--ease-quart);
  }

  .rating__meta:hover {
    color: var(--night-ink);
  }

  /* --- Art ---------------------------------------------------------------- */
  .hero__art {
    position: relative;
    min-height: clamp(280px, 60vw, 420px);
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .hero__art::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(180deg, var(--night) 0%, transparent 18%, transparent 82%, var(--night) 100%);
  }

  .hero__art--solo::after {
    display: none;
  }

  /* Three screenshots in a fanned stack, tilted like the home wall. */
  .hero__shots {
    position: absolute;
    inset: 0;
  }

  .hero__shots img {
    position: absolute;
    width: 74%;
    height: auto;
    border-radius: var(--r-md);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--night-ink) 12%, transparent), 0 24px 50px -24px rgba(0, 0, 0, 0.8);
  }

  .hero__shots img:nth-child(1) {
    top: 6%;
    left: 4%;
    rotate: -10deg;
    opacity: 0.55;
  }

  .hero__shots img:nth-child(2) {
    top: 24%;
    left: 22%;
    rotate: -4deg;
    opacity: 0.8;
  }

  .hero__shots img:nth-child(3) {
    top: 46%;
    left: 12%;
    rotate: 3deg;
  }

  .hero__mark {
    position: relative;
    z-index: 2;
    border-radius: 28%;
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--night-ink) 14%, transparent), 0 30px 60px -20px rgba(0, 0, 0, 0.85);
  }

  .hero__art:not(.hero__art--solo) .hero__mark {
    position: absolute;
    right: clamp(1rem, 8%, 3.5rem);
    bottom: clamp(1rem, 10%, 3.5rem);
  }

  .hero__mark img {
    display: block;
    border-radius: inherit;
  }

  @media (min-width: 960px) {
    .hero__panel {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      min-height: min(600px, calc(100dvh - 120px));
    }

    .hero__copy {
      justify-content: center;
      padding-block: clamp(3rem, 5vw, 4.5rem);
    }

    .hero__art {
      min-height: 0;
    }

    .hero__art::after {
      background:
        linear-gradient(90deg, var(--night) 0%, transparent 20%),
        linear-gradient(180deg, var(--night) 0%, transparent 14%, transparent 86%, var(--night) 100%);
    }
  }

  .more__title {
    font-size: var(--step-3);
    margin-bottom: 1.5rem;
  }

  .more {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
    gap: 1rem;
  }

</style>
