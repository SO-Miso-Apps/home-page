---
import { LiveEntryNotFoundError } from "astro/content/runtime";
import { decodeSlug, getEmDashEntry, getSeoMeta } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");
const { entry: post, error, isPreview, cacheHint } = await getEmDashEntry("posts", slug);

if (error) {
  // Astro live collections surface a missing entry as LiveEntryNotFoundError
  // rather than a null entry, so a content miss must answer 404, not 500.
  // rewrite (not redirect) so the URL itself serves the 404 status.
  if (LiveEntryNotFoundError.is(error)) return Astro.rewrite("/404");
  console.error("Failed to load post:", error);
  return new Response("Unable to load post", { status: 500 });
}
if (!post) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const data = post.data;

// An editor-set seo_title must outrank the content title, but getSeoMeta's
// internal chain (seo.title || defaultTitle || data.title) can never reach
// data.seo_title — Post.title is required, so with it fed plainly seo.title
// is never "". Resolve the effective title first and feed it to getSeoMeta
// as `defaultTitle`, which sits exactly where data.title would.
const effectiveTitle = data.seo_title || data.title;
const seo = getSeoMeta(post, {
  defaultTitle: effectiveTitle,
  siteUrl: Astro.site?.toString() ?? Astro.url.origin,
  path: Astro.url.pathname,
});

// No `siteTitle` here: Base.astro appends the site name itself, so passing
// it would double the suffix ("Post | Miso Apps — Miso Apps"). Without it
// the rendered <title> matches the site-wide "Page — Miso Apps" format.
// seo.title bottoms out at effectiveTitle, so the `||` chain is belt and
// suspenders (ruling: `||` chains, never `??`).
const title = seo.title || effectiveTitle;

// getSeoMeta returns description from the SEO panel or `data.excerpt` only;
// read the entry's own seo_description explicitly so it ranks above the
// excerpt fallback.
const description = data.seo_description || data.excerpt || seo.description || undefined;

const ogImageSrc = data.og_image?.src ?? undefined;

const jsonld: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: data.title,
  description: data.excerpt,
  datePublished: data.publishedAt ?? data.createdAt,
  dateModified: data.updatedAt ?? data.publishedAt ?? data.createdAt,
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString(),
};

// Bylines are hydrated by getEmDashEntry (ContentBylineCredit.byline.
// displayName); Article JSON-LD requires an author when available, and the
// key is omitted entirely when a post is uncredited.
const authors = (data.bylines ?? []).map((credit) => ({
  "@type": "Person",
  name: credit.byline.displayName,
}));
if (authors.length > 0) jsonld.author = authors.length === 1 ? authors[0] : authors;
---
<Base title={title} description={description} image={seo.ogImage ?? ogImageSrc} canonical={seo.canonical ?? undefined} robots={seo.robots ?? undefined}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  {isPreview && <p class="container preview-note">This is an unpublished preview.</p>}

  <article class="post">
    <div class="container narrow">
      <span class="eyebrow">Blog</span>
      <h1>{data.title}</h1>
      <div class="prose">
        <PortableText value={data.content} />
      </div>
      <p class="back">
        <a href="/blog">← All posts</a>
      </p>
    </div>
  </article>
</Base>

<style>
  .preview-note {
    color: var(--accent-dark);
  }
  .post {
    padding-block: 4rem 2rem;
  }
  .narrow {
    max-width: 720px;
  }
  h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin: 0.5rem 0 1.5rem;
  }
  .back {
    margin-top: 3rem;
  }
  .back a {
    color: var(--accent-dark);
    font-weight: 600;
    text-decoration: none;
  }
</style>
