---
import { getEmDashCollection } from "emdash";
import { WidgetArea } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const category = Astro.url.searchParams.get("category") ?? undefined;
// A malformed/garbled cursor makes the loader throw "Invalid pagination
// cursor" into `error`; a visitor with a stale link should get page one,
// not a 500 — so retry once without the cursor.
const rawCursor = Astro.url.searchParams.get("cursor") ?? undefined;

const baseFilter = {
  orderBy: { published_at: "desc" },
  limit: 10,
  where: category ? { category } : undefined,
} as const;

let { entries: posts, error, nextCursor, cacheHint } = await getEmDashCollection("posts", {
  ...baseFilter,
  cursor: rawCursor,
});
if (error && rawCursor) {
  console.error("Failed to load posts with cursor, retrying from page 1:", error);
  ({ entries: posts, error, nextCursor, cacheHint } = await getEmDashCollection("posts", baseFilter));
}
if (error) {
  console.error("Failed to load posts:", error);
  return new Response("Unable to load posts", { status: 500 });
}
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Fixed locale and zone so a cached render never disagrees with a fresh one.
const dateFormat = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});
const formatDate = (value: Date | string | null | undefined): { iso: string; label: string } | null => {
  if (!value) return null;
  const date = value instanceof Date ? value : new Date(value);
  if (Number.isNaN(date.getTime())) return null;
  return { iso: date.toISOString(), label: dateFormat.format(date) };
};
---

<Base title="Blog" description="Product updates and merchant playbooks from the Miso Apps team.">
  <section class="blog">
    <div class="container blog__head">
      <span class="eyebrow">
        <span class="eyebrow__dot" />
        Blog
      </span>
      <h1>Updates and playbooks.</h1>
      <p class="lede">
        Notes on Shopify operations, App Store review changes, and the decisions behind each
        app we ship.
      </p>
      {
        category && (
          <p class="blog__filter">
            Filtered by <span class="num">{category}</span> · <a href="/blog">Show all posts</a>
          </p>
        )
      }
    </div>

    <div class="container blog__grid">
      <div class="blog__main">
        {
          posts.length > 0 ? (
            <ul class="posts">
              {posts.map((post) => {
                const published = formatDate(post.data.publishedAt);
                return (
                  <li class="post" data-reveal>
                    <div class="post__meta">
                      {published && <time class="num" datetime={published.iso}>{published.label}</time>}
                      {"category" in post.data && post.data.category && <span class="post__cat">{post.data.category}</span>}
                    </div>
                    <h2>
                      <a href={`/blog/${post.id}`}>{post.data.title}</a>
                    </h2>
                    {"excerpt" in post.data && post.data.excerpt && <p>{post.data.excerpt}</p>}
                    <span class="post__more">
                      Read post
                      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
                        <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </span>
                  </li>
                );
              })}
            </ul>
          ) : (
            <p class="empty">
              No posts published yet{category ? ` in ${category}` : ""}. The first one is on its way.
            </p>
          )
        }

        {
          nextCursor && (
            <a
              class="btn btn--ghost older"
              href={`/blog?cursor=${encodeURIComponent(nextCursor)}${category ? `&category=${encodeURIComponent(category)}` : ""}`}
            >
              Older posts
            </a>
          )
        }
      </div>

      <aside class="blog__aside" aria-label="Blog sidebar">
        <WidgetArea name="blog-sidebar" class="sidebar-widgets" />
      </aside>
    </div>
  </section>
</Base>

<style>
  .blog {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  .blog__head {
    display: grid;
    gap: 0.8rem;
    max-width: 60ch;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }
  h1 {
    font-size: var(--step-5);
    letter-spacing: -0.035em;
  }
  .blog__filter {
    color: var(--ink-muted);
    font-size: 0.9375rem;
  }
  .blog__filter a {
    color: var(--brand-ink);
    font-weight: 600;
    text-decoration: none;
  }
  .blog__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 3rem);
    align-items: start;
  }
  .posts {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .post {
    display: grid;
    gap: 0.6rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--line);
  }
  .post__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.75rem;
    color: var(--ink-subtle);
  }
  .post__cat {
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-ink);
  }
  .post h2 {
    font-size: var(--step-3);
    max-width: 34ch;
  }
  .post h2 a {
    text-decoration: none;
    transition: color var(--dur-2) var(--ease-quart);
  }
  .post h2 a:hover {
    color: var(--brand-ink);
  }
  .post p {
    color: var(--ink-muted);
    max-width: 62ch;
  }
  .post__more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--brand-ink);
  }
  .post__more svg {
    transition: transform var(--dur-2) var(--ease-quart);
  }
  .post:hover .post__more svg {
    transform: translateX(3px);
  }
  .empty {
    color: var(--ink-muted);
    padding-block: 2rem;
  }
  .older {
    margin-top: 1.75rem;
  }
  .blog__aside {
    display: grid;
    gap: 1.25rem;
  }
  .blog__aside :global(.widget) {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  .blog__aside :global(.widget:last-child) {
    padding-bottom: 0;
    border-bottom: 0;
  }

  @media (min-width: 960px) {
    .blog__grid {
      grid-template-columns: minmax(0, 1fr) 18rem;
    }
    .blog__aside {
      position: sticky;
      top: 92px;
    }
  }
</style>
