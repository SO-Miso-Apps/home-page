---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ServiceTracks from "../components/ServiceTracks.astro";
import { getLang, localizeHref } from "../i18n";
import { SERVICES_BY_LANG } from "../services";

// A static route, so the copy ships with the deploy instead of the CMS. The
// page is deliberately not a `pages` entry: an editor-created page with the
// slug `services` would be shadowed by this file, and prose blocks cannot
// express two tracks with their own deliverables.
const lang = getLang(Astro.locals);
const copy = {
  en: {
    title: "Shopify theme customization and custom apps",
    description:
      "Shopify and Shopline theme design and customization, plus custom apps built around your workflow — looked at against your store, quoted before work starts, and reviewed on a copy of your theme before launch.",
    eyebrow: "Services",
    h1: { before: "Your theme, ", em: "reworked", after: " to fit the store you run now." },
    lede: "Most of our work is on the theme a store already runs: new sections, layout and style changes, speed fixes. When the job needs more than a theme can do, we build the app for it. Either way you get a scope and a price before we start, and you review everything before customers see it.",
    primary: "Send a request",
    secondary: "See our apps",
    tracks: {
      eyebrow: "What we do",
      title: "Two kinds of work, one way of doing it.",
      lead: "Pick the one that fits the job, or describe the problem and we will tell you which it is.",
    },
    process: {
      eyebrow: "How it works",
      title: "From request to launch in four steps.",
      lead: "No long discovery phase and no handoff to people you have not met. You know the scope, the price and the risks before any code is written.",
    },
    steps: [
      {
        title: "Tell us the job",
        body: "A few lines on what you want changed or what your team does by hand, with a link to your store.",
      },
      {
        title: "Scope and quote",
        body: "We look at your store, agree what is in and what is out, and send back the scope, the timeline and the price.",
      },
      {
        title: "Build and review",
        body: "You review each change as it lands, on a theme preview or a development store, so details settle before launch.",
      },
      {
        title: "Launch and hand over",
        body: "The theme is published or the app installed, and you keep the code, the notes and a direct line to the people who built it.",
      },
    ],
    needsHead: {
      eyebrow: "Before we start",
      title: "What we need from you.",
      lead: "Four things. If any are still open, say so in your first message — it usually saves a round of back-and-forth.",
    },
    needs: [
      {
        label: "Store access",
        body: "Your store URL and a collaborator or staff account on the Shopify or Shopline store we will work in.",
      },
      {
        label: "Brand assets",
        body: "Logo files, fonts, colours and product photos — or a note on what still has to be made.",
      },
      {
        label: "References",
        body: "Two or three stores, themes or apps you like, and what you like about each.",
      },
      {
        label: "Constraints",
        body: "When you want to launch, the budget range you have in mind, and anything on the store that must not change.",
      },
    ],
    request: {
      eyebrow: "Send a request",
      title: "What would you like to change?",
      lead: "Describe the job in a few lines. We reply with the scope, the timeline and the price — and tell you if one of our existing apps already does it.",
    },
  },
  vi: {
    title: "Tùy chỉnh theme Shopify và làm app theo yêu cầu",
    description:
      "Thiết kế, tùy chỉnh theme Shopify và Shopline, cùng app làm riêng theo quy trình của bạn — xem trực tiếp trên cửa hàng, báo giá trước khi làm và duyệt trên bản sao theme trước khi ra mắt.",
    eyebrow: "Dịch vụ",
    h1: { before: "Chỉnh lại theme cho ", em: "vừa", after: " với cửa hàng bạn đang có." },
    lede: "Phần lớn việc chúng tôi làm là sửa trên chính theme cửa hàng đang dùng: thêm section, đổi bố cục và giao diện, tăng tốc độ tải trang. Khi theme không đủ sức, chúng tôi làm app riêng cho việc đó. Dù là gì, bạn đều có phạm vi và báo giá trước khi bắt đầu, và được duyệt mọi thứ trước khi khách hàng nhìn thấy.",
    primary: "Gửi yêu cầu",
    secondary: "Xem các app của chúng tôi",
    tracks: {
      eyebrow: "Chúng tôi làm gì",
      title: "Hai mảng việc, chung một cách làm.",
      lead: "Chọn mảng hợp với việc bạn cần, hoặc cứ kể vấn đề, chúng tôi sẽ nói nó thuộc mảng nào.",
    },
    process: {
      eyebrow: "Cách chúng tôi làm",
      title: "Bốn bước từ lúc nhận yêu cầu đến khi ra mắt.",
      lead: "Không có giai đoạn khảo sát kéo dài, không chuyển qua người bạn chưa từng gặp. Bạn biết phạm vi, chi phí và rủi ro trước khi chúng tôi viết dòng code đầu tiên.",
    },
    steps: [
      {
        title: "Kể cho chúng tôi nghe",
        body: "Vài dòng về điều bạn muốn đổi hoặc việc đội bạn đang phải làm tay, kèm đường dẫn tới cửa hàng.",
      },
      {
        title: "Chốt phạm vi và báo giá",
        body: "Chúng tôi xem cửa hàng, thống nhất việc nào làm và việc nào không, rồi gửi phạm vi, thời gian và chi phí.",
      },
      {
        title: "Làm và duyệt",
        body: "Bạn xem từng thay đổi ngay khi xong, trên bản xem trước của theme hoặc cửa hàng thử nghiệm, để chốt mọi chi tiết trước khi ra mắt.",
      },
      {
        title: "Ra mắt và bàn giao",
        body: "Theme được xuất bản hoặc app được cài đặt. Bạn giữ mã nguồn, ghi chú và liên hệ trực tiếp với người đã làm.",
      },
    ],
    needsHead: {
      eyebrow: "Trước khi bắt đầu",
      title: "Bạn cần chuẩn bị gì.",
      lead: "Bốn thứ dưới đây. Nếu còn thứ gì chưa rõ, bạn cứ ghi luôn trong tin nhắn đầu tiên — hai bên sẽ đỡ phải hỏi đi hỏi lại.",
    },
    needs: [
      {
        label: "Quyền truy cập",
        body: "Địa chỉ cửa hàng và một tài khoản collaborator hoặc staff trên cửa hàng Shopify hoặc Shopline mà chúng tôi sẽ làm.",
      },
      {
        label: "Nhận diện thương hiệu",
        body: "Logo, font chữ, màu sắc và ảnh sản phẩm — hoặc ghi chú những gì còn cần làm thêm.",
      },
      {
        label: "Mẫu tham khảo",
        body: "Hai, ba cửa hàng, theme hoặc app bạn thích, và bạn thích điểm gì ở mỗi cái.",
      },
      {
        label: "Giới hạn",
        body: "Khi nào bạn muốn ra mắt, ngân sách dự kiến, và những gì trên cửa hàng không được thay đổi.",
      },
    ],
    request: {
      eyebrow: "Gửi yêu cầu",
      title: "Bạn muốn đổi gì trên cửa hàng?",
      lead: "Mô tả trong vài dòng. Chúng tôi sẽ trả lời kèm phạm vi, thời gian và báo giá — và nói luôn nếu đã có app sẵn của chúng tôi làm được việc đó.",
    },
  },
}[lang];
---

<Base title={copy.title} description={copy.description}>
  <section class="section head-section" aria-labelledby="services-title">
    <div class="container">
      <div class="page-head">
        <span class="eyebrow">
          <span class="eyebrow__dot" />
          {copy.eyebrow}
        </span>
        <h1 id="services-title">{copy.h1.before}<em>{copy.h1.em}</em>{copy.h1.after}</h1>
        <p class="lede">{copy.lede}</p>
        <div class="page-head__actions">
          <a class="btn btn--brand btn--lg" href="#request">
            {copy.primary}
            <svg class="btn__arrow" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" focusable="false">
              <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a class="btn btn--ghost btn--lg" href={localizeHref("/#apps", lang)}>{copy.secondary}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="tracks-title">
    <div class="container">
      <SectionHeader id="tracks-title" eyebrow={copy.tracks.eyebrow} title={copy.tracks.title} lead={copy.tracks.lead} />
      <div class="tracks-wrap">
        <ServiceTracks tracks={SERVICES_BY_LANG[lang]} />
      </div>
    </div>
  </section>

  <ProcessSteps eyebrow={copy.process.eyebrow} title={copy.process.title} lead={copy.process.lead} steps={copy.steps} />

  <section class="section" aria-labelledby="needs-title">
    <div class="container">
      <SectionHeader id="needs-title" eyebrow={copy.needsHead.eyebrow} title={copy.needsHead.title} lead={copy.needsHead.lead} />
      <dl class="needs">
        {
          copy.needs.map((need) => (
            <div class="needs__row">
              <dt class="needs__label">{need.label}</dt>
              <dd class="needs__body">{need.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section band request" id="request" aria-labelledby="request-title">
    <div class="container">
      <SectionHeader id="request-title" eyebrow={copy.request.eyebrow} title={copy.request.title} lead={copy.request.lead} />
      <div class="request__body">
        <ContactForm />
      </div>
    </div>
  </section>
</Base>

<style>
  .head-section {
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 3vw, 2.5rem);
  }
  .page-head {
    display: grid;
    justify-items: start;
    gap: 1rem;
    max-width: 62ch;
  }
  h1 {
    font-size: var(--step-5);
    letter-spacing: -0.035em;
  }
  .page-head__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  /* Wrapper, not a class passed into ServiceTracks: a parent's scoped style
     cannot reach a child component's root element. */
  .tracks-wrap {
    margin-top: 2.5rem;
  }
  .needs {
    margin: 2.5rem 0 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
  }
  .needs__row {
    display: grid;
    gap: 0.55rem;
    align-content: start;
    padding: 1.5rem;
    border-radius: var(--r-lg);
    background: var(--tofu);
  }
  .needs__label {
    font-weight: 600;
    color: var(--ink);
  }
  .needs__body {
    margin: 0;
    max-width: 46ch;
    color: var(--ink-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  /* The form is the one place on the page that wants a single column at every
     width: a 1240px-wide input row reads like a spreadsheet. */
  .request {
    scroll-margin-top: 5rem;
  }
  .request__body {
    margin-top: 2.5rem;
    max-width: 760px;
  }

  @media (min-width: 760px) {
    .needs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .needs {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
