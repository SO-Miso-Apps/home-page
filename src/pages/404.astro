---
import Base from "../layouts/Base.astro";
import { getLang, localizeHref } from "../i18n";

const lang = getLang(Astro.locals);
const copy = {
  en: {
    title: "Page not found",
    h1: "This page took a wrong turn.",
    lede: "The address you followed does not exist on this site. It may have been renamed, or the link that brought you here may be out of date.",
    links: ["Home", "Services", "Our apps", "Blog"],
  },
  vi: {
    title: "Không tìm thấy trang",
    h1: "Không tìm thấy trang này.",
    lede: "Có thể trang đã đổi địa chỉ, hoặc đường dẫn bạn bấm vào đã cũ. Bạn thử một trong các trang dưới đây nhé.",
    links: ["Trang chủ", "Dịch vụ", "Các app", "Blog"],
  },
}[lang];
const links = ["/", "/services", "/#apps", "/blog"].map((href, index) => ({
  label: copy.links[index],
  href: localizeHref(href, lang),
}));
---

<Base title={copy.title} robots="noindex">
  <section class="notfound">
    <div class="container notfound__inner">
      <span class="notfound__code" aria-hidden="true">404</span>
      <h1>{copy.h1}</h1>
      <p class="lede">{copy.lede}</p>
      <ul class="notfound__links">
        {
          links.map((link) => (
            <li>
              <a href={link.href}>
                {link.label}
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
                  <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .notfound {
    position: relative;
    padding-block: clamp(3.5rem, 10vw, 7rem);
  }
  .notfound__inner {
    display: grid;
    gap: 1rem;
    justify-items: start;
    max-width: 60ch;
  }
  .notfound__code {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(4rem, 14vw, 8rem);
    line-height: 0.9;
    font-weight: 500;
    color: var(--brand);
    letter-spacing: -0.04em;
  }
  h1 {
    font-size: var(--step-4);
    letter-spacing: -0.03em;
  }
  .notfound__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin-top: 0.75rem;
  }
  .notfound__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0 1.1rem;
    border: 1px solid var(--tofu-line);
    border-radius: var(--r-pill);
    background: var(--tofu);
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      border-color var(--dur-2) var(--ease-quart),
      color var(--dur-2) var(--ease-quart),
      transform var(--dur-1) var(--ease-quart);
  }
  .notfound__links a:hover {
    border-color: var(--brand-line);
    color: var(--brand-ink);
    transform: translateY(-1px);
  }
  .notfound__links a:active {
    transform: scale(0.98);
  }
</style>
