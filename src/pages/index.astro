---
import { getEmDashCollection, getSeoMeta } from "emdash";
import Base from "../layouts/Base.astro";
import AppCard from "../components/AppCard.astro";
import AppMark from "../components/AppMark.astro";
import CtaPanel from "../components/CtaPanel.astro";
import Marquee from "../components/Marquee.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ServiceTracks from "../components/ServiceTracks.astro";
import StatStrip from "../components/StatStrip.astro";
import { SERVICES } from "../services";

const { entries: apps, error, cacheHint } = await getEmDashCollection("apps", {
  orderBy: { sort_order: "asc" },
});
if (error) {
  console.error("Failed to load apps:", error);
  return new Response("Unable to load apps", { status: 500 });
}
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// getSeoMeta requires a content-shaped object; the home page has no CMS entry,
// so pass an empty data shell and resolve meta from site defaults.
const seo = getSeoMeta({ data: {} }, {
  siteTitle: "Miso Apps",
  siteUrl: Astro.site?.toString() ?? Astro.url.origin,
  path: Astro.url.pathname,
});

// Bento rhythm: cells alternate long/short so the grid never reads as a row of
// equal boxes. Two entries or fewer fall back to a half-width pair.
const RHYTHM = [4, 2, 2, 4];
const spanFor = (index: number) => (apps.length <= 2 ? 3 : RHYTHM[index % RHYTHM.length]);

// The rating tile is computed from the catalog so it can never drift from the
// entries an editor publishes; the other three are studio claims from the
// previous site and stay as written.
const rated = apps.filter((app) => typeof app.data.rating_value === "number");
const averageRating = rated.length
  ? rated.reduce((total, app) => total + (app.data.rating_value ?? 0), 0) / rated.length
  : null;

const stats = [
  { value: String(apps.length), label: "Apps on the App Store" },
  { value: "10K+", label: "Merchant stores reached" },
  { value: "50+", label: "Countries served" },
  { value: averageRating ? averageRating.toFixed(1) : "—", label: "Average app rating" },
];

const ticker = [
  ...apps.map((app) => app.data.badge).filter((badge): badge is string => Boolean(badge)),
  "Shopify",
  "Shopline",
  "Admin GraphQL",
  "Webhooks",
  "Support 24/7",
];
---

<Base title="Commerce apps for stores that keep moving" description={seo.description ?? undefined} image={seo.ogImage ?? undefined} canonical={seo.canonical ?? undefined} robots={seo.robots ?? undefined}>
  <section class="hero" data-hero>
    <div class="container hero__grid">
      <div class="hero__copy">
        <span class="eyebrow" data-hero-item>
          <span class="eyebrow__dot" />
          Shopify app studio
        </span>
        <h1 data-hero-item>
          <span class="hero__line">Commerce apps built for stores</span>
          <span class="hero__line hero__line--dim">that have to keep moving.</span>
        </h1>
        <p class="lede" data-hero-item>
          Miso Apps designs and ships focused Shopify and Shopline apps for
          automation, conversion, and AI-readable storefront data. The work is
          clean, fast, and built around merchant operations.
        </p>
        <div class="hero__actions" data-hero-item>
          <a class="btn btn--brand btn--lg" href="#apps">
            View our apps
            <svg class="btn__arrow" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" focusable="false">
              <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a class="btn btn--ghost btn--lg" href="/about">About the studio</a>
        </div>
      </div>

      <div class="hero__art" data-hero-art>
        <div class="hero__panel glass" data-float>
          <div class="hero__panel-top">
            <span class="hero__panel-label">App Store listings</span>
            <span class="hero__status num">
              <span class="hero__status-dot" aria-hidden="true" />
              {apps.length} live
            </span>
          </div>

          <div class="orb-wrap">
            <div class="orb" aria-hidden="true" />
          </div>

          <ul class="hero__apps">
            {
              apps.map((app) => (
                <li class="hero__app">
                  <AppMark seed={app.id} size={30} />
                  <span class="hero__app-name">{app.data.name}</span>
                  {app.data.badge && <span class="hero__app-badge">{app.data.badge}</span>}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-label="Studio at a glance">
    <div class="container">
      <Marquee items={ticker} />
      <StatStrip stats={stats} class="hero__stats" />
    </div>
  </section>

  <section class="section" id="apps" aria-labelledby="apps-title">
    <div class="container">
      <SectionHeader
        id="apps-title"
        eyebrow="Our apps"
        title="Focused products, measurable results."
        lead="Every app below is live on the Shopify App Store. Each one does a single operational job properly, and each listing page is built from the same CMS entry the store team edits."
      />
      <div class="bento">
        {
          apps.map((app, index) => {
            const span = spanFor(index);
            return (
              <div class="bento__cell" data-span={span}>
                <AppCard app={app} variant={span >= 4 ? "wide" : "narrow"} />
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section" id="services" aria-labelledby="services-title">
    <div class="container">
      <SectionHeader
        id="services-title"
        eyebrow="Services"
        title="When the catalog is close but not close enough."
        lead="Beyond the apps: a custom app for the workflow your team still runs by hand, and a theme built to your brand instead of stretched around someone else's. Both are scoped against your store and reviewed before launch."
      />
      <div class="tracks-wrap">
        <ServiceTracks tracks={SERVICES} />
      </div>
      <div class="services__more">
        <a class="btn btn--ghost" href="/services">
          How a custom build runs
          <svg class="btn__arrow" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" focusable="false">
            <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <ProcessSteps
    title="Ship something merchants can trust on a busy Monday."
    lead="Four steps, in this order, every time. No long discovery decks and no handoffs to a team you never met."
    steps={[
      {
        title: "Scope on your store",
        body: "We start from the workflow itself: order volume, who edits what, and which parts of the admin your team works around.",
      },
      {
        title: "Build on the Shopify APIs",
        body: "Admin GraphQL, webhooks, and Functions. No brittle theme hacks, and nothing that slows the storefront down.",
      },
      {
        title: "Review on a live store",
        body: "You test every flow on a real development store before it reaches merchants. Copy, edge cases, and permissions are settled there.",
      },
      {
        title: "Ship and keep the pager on",
        body: "Listed on the App Store, watched for review notices and API changes, and answered by the people who wrote the code.",
      },
    ]}
  />

  <CtaPanel
    seed="home-cta"
    eyebrow="Get started"
    title="Put an app to work on your store this week."
    body="Install from the App Store, or tell us which operational job is costing your team the most time."
    primary={{ label: "Browse the apps", href: "#apps" }}
    secondary={{ label: "About the studio", href: "/about" }}
  />
</Base>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(1rem, 3vw, 2rem);
  }

  /* Ambient wash behind the hero copy — one soft radial, no outer glow. Kept
     inside the container's horizontal bounds so it can never widen the page. */
  .hero::before {
    content: "";
    position: absolute;
    inset: -20% 0 auto 0;
    height: 70%;
    background: radial-gradient(
      ellipse 72% 62% at 18% 0%,
      color-mix(in oklab, var(--brand) 13%, transparent),
      transparent 70%
    );
    pointer-events: none;
    z-index: -1;
  }

  .hero__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }

  .hero__copy {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
  }

  .hero__line {
    display: block;
  }

  .hero__line--dim {
    color: var(--ink-subtle);
  }

  h1 {
    font-size: var(--step-5);
    letter-spacing: -0.035em;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .hero__art {
    display: grid;
  }

  .hero__panel {
    display: grid;
    gap: 1.25rem;
    padding: 1.25rem;
    border-radius: var(--r-2xl);
  }

  .hero__panel-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .hero__panel-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-subtle);
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    color: var(--brand-ink);
  }

  .hero__status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 3px var(--brand-soft);
  }

  /* --- Orb: the one piece of pure decoration in the hero ---------------- */
  @property --orb-angle {
    syntax: "<angle>";
    inherits: false;
    initial-value: 0deg;
  }

  .orb-wrap {
    position: relative;
    display: grid;
    place-items: center;
    padding-block: 0.5rem;
  }

  .orb-wrap::before {
    content: "";
    position: absolute;
    inset: 6%;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in oklab, var(--brand) 26%, transparent), transparent 62%);
    filter: blur(28px);
    pointer-events: none;
  }

  .orb {
    position: relative;
    width: min(58%, 190px);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(circle at 32% 26%, color-mix(in oklab, var(--brand) 32%, #ffffff), transparent 46%),
      radial-gradient(circle at 74% 78%, color-mix(in oklab, var(--brand-hover) 90%, transparent), transparent 60%),
      linear-gradient(
        160deg,
        color-mix(in oklab, var(--brand) 38%, var(--canvas-deep)),
        color-mix(in oklab, var(--brand-hover) 58%, var(--canvas-deep))
      );
  }

  /* Kept on a pseudo-element so browsers without @property still render the
     base gradients above instead of dropping an invalid background list. */
  .orb::before {
    content: "";
    position: absolute;
    inset: -10%;
    background: conic-gradient(
      from var(--orb-angle) at 42% 58%,
      transparent,
      color-mix(in oklab, var(--brand) 62%, transparent) 18%,
      transparent 42%,
      color-mix(in oklab, var(--brand-on-dark) 48%, transparent) 66%,
      transparent 88%
    );
    filter: blur(14px) saturate(1.2);
    animation: orb-spin 26s linear infinite;
  }

  .orb::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.2),
      inset 0 10px 22px rgba(255, 255, 255, 0.18),
      inset 0 -16px 30px rgba(0, 0, 0, 0.3);
  }

  @keyframes orb-spin {
    to {
      --orb-angle: 360deg;
    }
  }

  .hero__apps {
    display: grid;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
  }

  .hero__app {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.55rem 0.5rem;
    border-radius: var(--r-sm);
    transition: background-color var(--dur-2) var(--ease-quart);
  }

  .hero__app:hover {
    background: var(--surface-2);
  }

  .hero__app-name {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hero__app-badge {
    margin-left: auto;
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-subtle);
  }

  .hero__stats {
    margin-top: 2rem;
  }

  /* --- Bento ------------------------------------------------------------ */
  .bento {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  .bento__cell {
    grid-column: span 6;
  }

  @media (min-width: 700px) {
    .bento__cell[data-span="2"] {
      grid-column: span 3;
    }
    .bento__cell[data-span="3"] {
      grid-column: span 3;
    }
    .bento__cell[data-span="4"] {
      grid-column: span 6;
    }
  }

  @media (min-width: 1040px) {
    .bento__cell[data-span="2"] {
      grid-column: span 2;
    }
    .bento__cell[data-span="3"] {
      grid-column: span 3;
    }
    .bento__cell[data-span="4"] {
      grid-column: span 4;
    }
  }

  @media (min-width: 960px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    }
  }

  .tracks-wrap {
    margin-top: 2.5rem;
  }

  .services__more {
    margin-top: 2rem;
  }
</style>
