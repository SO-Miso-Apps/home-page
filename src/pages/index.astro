---
import { getSeoMeta } from "emdash";
import type { App } from "../../emdash-env";
import Base from "../layouts/Base.astro";
import AppCard from "../components/AppCard.astro";
import CtaPanel from "../components/CtaPanel.astro";
import Faq from "../components/Faq.astro";
import PricingPlans from "../components/PricingPlans.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import ReviewBand from "../components/ReviewBand.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { FAQ_BY_LANG } from "../faq";
import { getLang, localizeHref } from "../i18n";
import { getLocalizedCollection } from "../lib/content";
import { summarizeRatings } from "../lib/ratings";
import { getWork } from "../work";

const lang = getLang(Astro.locals);

const { entries: apps, error, cacheHint } = await getLocalizedCollection<"apps", App>(
  "apps",
  { orderBy: { sort_order: "asc" } },
  lang,
);
if (error) {
  console.error("Failed to load apps:", error);
  return new Response("Unable to load apps", { status: 500 });
}
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// getSeoMeta requires a content-shaped object; the home page has no CMS entry,
// so pass an empty data shell and resolve meta from site defaults.
const seo = getSeoMeta({ data: {} }, {
  siteTitle: "Miso Apps",
  siteUrl: Astro.site?.toString() ?? Astro.url.origin,
  path: Astro.url.pathname,
});

// The home page leads with the theme service; the app catalog follows it.
// Every claim here is one the studio can show: the live storefronts in
// work.ts, the steps on /services, the apps in the CMS. No invented numbers.
const copy = {
  en: {
    title: "Shopify theme design, customization and apps",
    h1: { before: "Shopify themes for brands that ", em: "stand out", after: "." },
    lede: "New themes, reworked themes, and the apps behind them. Every page stays editable in the theme editor — no developer needed for a change.",
    primary: "Get a quote",
    secondary: "See the work",
    proof: {
      stores: "live storefronts",
      rating: "on the Shopify App Store",
      stars: (r: string) => `${r} out of 5 stars`,
    },
    work: {
      eyebrow: "Selected work",
      title: "Live stores. Real themes.",
      lead: "Stores selling today on themes we've worked on, plus demo stores of our own themes. Click around.",
      theme: "Theme",
      locked: "Password-protected for now",
      password: "Store password",
      visit: "Visit store",
      newTab: "(opens in a new tab)",
      shot: (domain: string) => `Home page of ${domain}`,
    },
    services: {
      eyebrow: "Theme services",
      title: "Three ways we work on your theme.",
      cards: [
        { title: "A new theme", body: "Designed around your brand, with every page you sell on: home, collection, product, cart.", shot: "A collection page on a demo store, with filters and a four-column product grid" },
        { title: "Rework your theme", body: "New sections, new layouts, a new look — on the theme you already run.", shot: "A section being dragged into a new place on a demo store in the theme editor" },
        { title: "Faster, more accessible", body: "Core Web Vitals, keyboard navigation, contrast, and no layout shift while a page loads.", shot: "A demo store's product page with a visible keyboard focus ring on the add-to-cart button" },
      ],
      more: "All services",
      apps: "Need a custom app instead?",
      appsLink: "Custom app development",
    },
    process: {
      eyebrow: "How we work",
      title: "Four steps. You sign off on each.",
      steps: [
        { title: "Brief", body: "A few lines on your store, your theme, and what should change." },
        { title: "Quote", body: "We review the live store, agree the scope, and quote before work starts." },
        { title: "Preview", body: "Every part lands on a preview of your theme first. You comment before it goes live." },
        { title: "Handover", body: "The theme is published. You keep every file, the notes, and a direct line to whoever built it." },
      ],
    },
    apps: {
      eyebrow: "Our apps",
      title: "Apps by Miso.",
      lead: "Built by the same team, listed on the Shopify App Store.",
    },
    faq: {
      eyebrow: "FAQ",
      title: "Before you ask.",
      lead: "Short answers to the usual questions. Anything else, ask us.",
    },
    cta: {
      title: "Tell us what to change.",
      body: "A few lines is enough. We reply within one working day with a scope and a quote.",
      primary: "Get a quote",
    },
  },
  vi: {
    title: "Thiết kế, tùy biến theme và app Shopify",
    h1: { before: "Theme Shopify cho thương hiệu muốn ", em: "khác biệt", after: "." },
    lede: "Làm theme mới, chỉnh theme đang dùng, và cả app đi kèm. Mọi trang vẫn sửa được trong trình chỉnh sửa theme — không cần nhờ lập trình viên.",
    primary: "Nhận báo giá",
    secondary: "Xem dự án",
    proof: {
      stores: "cửa hàng đang chạy",
      rating: "trên Shopify App Store",
      stars: (r: string) => `${r} trên 5 sao`,
    },
    work: {
      eyebrow: "Dự án",
      title: "Cửa hàng thật. Theme thật.",
      lead: "Các cửa hàng đang bán hàng trên theme chúng tôi đã làm, cùng store demo theme của Miso. Cứ vào bấm thử.",
      theme: "Theme",
      locked: "Hiện store đang đặt mật khẩu",
      password: "Mật khẩu store",
      visit: "Xem cửa hàng",
      newTab: "(mở trong tab mới)",
      shot: (domain: string) => `Trang chủ của ${domain}`,
    },
    services: {
      eyebrow: "Dịch vụ theme",
      title: "Ba cách chúng tôi làm theme cho bạn.",
      cards: [
        { title: "Theme mới", body: "Thiết kế theo thương hiệu, đủ mọi trang bán hàng: trang chủ, danh mục, sản phẩm, giỏ hàng.", shot: "Trang danh mục của một cửa hàng demo, có bộ lọc và lưới sản phẩm bốn cột" },
        { title: "Chỉnh theme đang dùng", body: "Thêm section, đổi bố cục, làm mới giao diện — ngay trên theme hiện tại.", shot: "Một section đang được kéo sang vị trí mới trên cửa hàng demo trong trình chỉnh sửa theme" },
        { title: "Nhanh hơn, dễ dùng hơn", body: "Core Web Vitals, điều hướng bàn phím, độ tương phản, không giật bố cục khi tải trang.", shot: "Trang sản phẩm của cửa hàng demo, nút thêm vào giỏ đang có viền focus bàn phím rõ ràng" },
      ],
      more: "Tất cả dịch vụ",
      apps: "Cần một app làm riêng?",
      appsLink: "Làm app theo yêu cầu",
    },
    process: {
      eyebrow: "Cách làm",
      title: "Bốn bước. Bạn duyệt từng bước.",
      steps: [
        { title: "Gửi mô tả", body: "Vài dòng về cửa hàng, theme đang dùng và điều cần đổi." },
        { title: "Báo giá", body: "Chúng tôi xem cửa hàng thật, chốt phạm vi và báo giá trước khi làm." },
        { title: "Duyệt bản xem trước", body: "Mỗi phần lên bản xem trước của theme trước. Bạn góp ý rồi mới công khai." },
        { title: "Bàn giao", body: "Theme được xuất bản. Bạn giữ toàn bộ file, tài liệu và liên hệ trực tiếp với người đã làm." },
      ],
    },
    apps: {
      eyebrow: "Ứng dụng",
      title: "App của Miso.",
      lead: "Do chính đội ngũ này làm, có trên Shopify App Store.",
    },
    faq: {
      eyebrow: "Hỏi đáp",
      title: "Trước khi bạn hỏi.",
      lead: "Trả lời ngắn cho những câu hay gặp. Còn gì khác, cứ hỏi chúng tôi.",
    },
    cta: {
      title: "Bạn muốn đổi gì?",
      body: "Vài dòng là đủ. Chúng tôi phản hồi trong một ngày làm việc, kèm phạm vi và báo giá.",
      primary: "Nhận báo giá",
    },
  },
}[lang];

const contactHref = localizeHref("/services#request", lang);
const work = getWork(lang);
const { average } = summarizeRatings(apps);
const rating = average === null ? null : average.toLocaleString(lang === "vi" ? "vi-VN" : "en-US", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
// The hero wall: every storefront from the work section, dealt into three
// columns and repeated so each column runs past the panel's top and bottom.
const WALL_COLUMNS = 3;
const WALL_DEPTH = 6;
const wall = Array.from({ length: WALL_COLUMNS }, (_, col) =>
  Array.from({ length: WALL_DEPTH }, (_, row) => work[(col + row * WALL_COLUMNS) % work.length].image),
);
const TONES = ["tint", "mist", "night"] as const;
// One demo-store screenshot per service card, in card order.
const SERVICE_SHOTS = ["/demo/svc-collection.webp", "/demo/svc-editor-drag.webp", "/demo/svc-product-focus.webp"];
---

<Base title={copy.title} description={lang === "vi" ? undefined : (seo.description ?? undefined)} image={seo.ogImage ?? undefined} canonical={seo.canonical ?? undefined} robots={seo.robots ?? undefined}>
  <section class="hero" data-hero aria-labelledby="hero-title">
    <div class="hero__panel tone-night">
      <div class="hero__copy">
        <h1 id="hero-title" data-hero-item>{copy.h1.before}<em>{copy.h1.em}</em>{copy.h1.after}</h1>
        <p class="hero__lede" data-hero-item>{copy.lede}</p>
        <div class="hero__actions" data-hero-item>
          <a class="btn btn--brand btn--lg" href={contactHref}>
            {copy.primary}
            <svg class="btn__arrow" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
              <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a class="btn btn--outline btn--lg" href="#work">{copy.secondary}</a>
        </div>
        <ul class="hero__proof" role="list" data-hero-item>
          <li>
            <span class="hero__thumbs" aria-hidden="true">
              {work.slice(0, 3).map((item) => <img src={item.image.src} width="40" height="40" alt="" decoding="async" />)}
            </span>
            <span><strong class="num">{work.length}</strong> {copy.proof.stores}</span>
          </li>
          {rating && (
            <li>
              <span class="hero__star" role="img" aria-label={copy.proof.stars(rating)}>★</span>
              <span><strong class="num">{rating}</strong> {copy.proof.rating}</span>
            </li>
          )}
        </ul>
      </div>

      {/* Decorative: the same storefronts the work section lists, as a tilted
          wall whose columns drift apart on scroll (motion.ts, data-wall-col). */}
      <div class="hero__wall" aria-hidden="true" data-hero-art>
        <div class="hero__grid">
          {
            wall.map((column, index) => (
              <div class="hero__col" data-wall-col={index}>
                {column.map((image) => (
                  <img src={image.src} width={image.width} height={image.height} alt="" decoding="async" />
                ))}
              </div>
            ))
          }
        </div>
        <div class="hero__phone" data-float>
          <img src="/demo/product-mobile.webp" width="660" height="1428" alt="" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="work" aria-labelledby="work-title">
    <div class="container">
      <SectionHeader id="work-title" eyebrow={copy.work.eyebrow} title={copy.work.title} lead={copy.work.lead} />
      <ul class="work">
        {
          work.map((item) => (
            <li class="work__item" data-reveal>
              <div class="work__shot">
                <img
                  src={item.image.src}
                  width={item.image.width}
                  height={item.image.height}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="work__body">
                <div class="work__tags">
                  {item.tags.map((tag) => <span class="badge">{tag}</span>)}
                </div>
                <h3 class="work__domain">
                  <a href={item.url} target="_blank" rel="noopener noreferrer">
                    {item.name}
                    <span class="sr-only"> {copy.work.newTab}</span>
                  </a>
                </h3>
                <p class="work__about">{item.about}</p>
                <p class="work__theme">
                  <span class="dim">{copy.work.theme}:</span> {item.theme}
                </p>
                {item.locked && <p class="work__locked">{copy.work.locked}</p>}
                {item.password && (
                  <p class="work__password">
                    <span class="dim">{copy.work.password}:</span> <code>{item.password}</code>
                  </p>
                )}
                <span class="work__visit" aria-hidden="true">
                  {copy.work.visit}
                  <svg viewBox="0 0 16 16" width="14" height="14" focusable="false">
                    <path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section services" id="services" aria-labelledby="services-title">
    <div class="container">
      <SectionHeader id="services-title" eyebrow={copy.services.eyebrow} title={copy.services.title} />
      <ol class="services__grid">
        {
          copy.services.cards.map((card, index) => (
            <li class:list={["service", `tone-${TONES[index % TONES.length]}`]} data-reveal>
              <span class="service__num">{String(index + 1).padStart(2, "0")}</span>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
              <div class="service__shot">
                <img src={SERVICE_SHOTS[index]} width="1440" height="960" alt={card.shot} loading="lazy" decoding="async" />
              </div>
            </li>
          ))
        }
      </ol>
      <div class="services__foot">
        <a class="btn btn--ghost" href={localizeHref("/services#custom-themes", lang)}>
          {copy.services.more}
          <svg class="btn__arrow" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" focusable="false">
            <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <p class="services__apps">
          {copy.services.apps}{" "}
          <a href={localizeHref("/services#custom-apps", lang)}>{copy.services.appsLink}</a>
        </p>
      </div>
    </div>
  </section>

  <PricingPlans />

  <ProcessSteps id="process" band eyebrow={copy.process.eyebrow} title={copy.process.title} steps={copy.process.steps} />

  <section class="section" id="apps" aria-labelledby="apps-title">
    <div class="container">
      <SectionHeader id="apps-title" eyebrow={copy.apps.eyebrow} title={copy.apps.title} lead={copy.apps.lead} />
      <ul class="apps">
        {
          apps.map((app, index) => (
            <li>
              <AppCard app={app} tone={(["tint", "night", "brand", "mist"] as const)[index % 4]} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ReviewBand apps={apps} />

  <Faq eyebrow={copy.faq.eyebrow} title={copy.faq.title} lead={copy.faq.lead} items={FAQ_BY_LANG[lang]} />

  <CtaPanel title={copy.cta.title} body={copy.cta.body} primary={{ label: copy.cta.primary, href: contactHref }} showcase />
</Base>

<style>
  /* --- Hero --------------------------------------------------------------- */
  /* A night panel inset like a band: copy on the left, a tilted wall of real
     storefront captures on the right that bleeds off the panel's edges. */
  .hero {
    padding-top: clamp(0.5rem, 1.5vw, 1rem);
  }

  .hero__panel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-inline: clamp(0.5rem, 1.5vw, 1.25rem);
    border-radius: var(--r-2xl);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(1.25rem, 2.2vw, 1.75rem);
    padding: clamp(2.5rem, 7vw, 5.5rem) clamp(1.25rem, 5vw, 4.5rem) clamp(2rem, 4vw, 3rem);
  }

  h1 {
    font-size: clamp(2.6rem, 1.2rem + 4.6vw, 5.4rem);
    line-height: 1.08;
    letter-spacing: var(--track-hero);
    color: var(--night-ink);
    max-width: 13ch;
  }

  .hero__lede {
    color: var(--tone-muted);
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
    line-height: 1.65;
    max-width: 44ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Secondary action on the night ground: a hairline pill. */
  .btn--outline {
    background: transparent;
    color: var(--night-ink);
    border-color: color-mix(in oklab, var(--night-ink) 26%, transparent);
  }

  .btn--outline:hover {
    border-color: color-mix(in oklab, var(--night-ink) 60%, transparent);
    transform: translateY(-1px);
  }

  .hero__proof {
    list-style: none;
    padding: 1.25rem 0 0;
    margin-top: 0.25rem;
    border-top: 1px solid color-mix(in oklab, var(--night-ink) 14%, transparent);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    font-size: 0.9375rem;
    color: var(--tone-muted);
  }

  .hero__proof li {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }

  .hero__proof strong {
    color: var(--night-ink);
    font-weight: 600;
  }

  .hero__thumbs {
    display: inline-flex;
  }

  .hero__thumbs img {
    width: 30px;
    height: 30px;
    object-fit: cover;
    object-position: left top;
    border-radius: 50%;
    border: 2px solid var(--night);
  }

  .hero__thumbs img + img {
    margin-left: -10px;
  }

  .hero__star {
    color: var(--night-accent);
    font-size: 1.05rem;
    line-height: 1;
  }

  /* --- Wall -------------------------------------------------------------- */
  .hero__wall {
    position: relative;
    height: clamp(320px, 62vw, 460px);
    overflow: hidden;
  }

  /* Fade the wall into the panel so the captures read as texture, not as a
     second piece of content. */
  .hero__wall::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(180deg, var(--night) 0%, transparent 22%, transparent 78%, var(--night) 100%);
  }

  .hero__grid {
    position: absolute;
    top: -30%;
    left: -12%;
    width: 124%;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.6rem, 1.2vw, 1rem);
    rotate: -9deg;
  }

  .hero__col {
    display: grid;
    gap: clamp(0.6rem, 1.2vw, 1rem);
    align-content: start;
  }

  .hero__col:nth-child(2) {
    margin-top: -18%;
  }

  .hero__col:nth-child(3) {
    margin-top: -6%;
  }

  .hero__col img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--r-md);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--night-ink) 10%, transparent), 0 18px 40px -20px rgba(0, 0, 0, 0.7);
  }

  /* A phone, drawn as a dark bezel around the screenshot. */
  .hero__phone {
    position: absolute;
    z-index: 2;
    right: clamp(1rem, 8%, 4rem);
    bottom: clamp(1rem, 6%, 3rem);
    width: clamp(110px, 24%, 200px);
    padding: clamp(4px, 0.6vw, 7px);
    border-radius: clamp(1.1rem, 2.4vw, 2rem);
    background: #0a0a0a;
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--night-ink) 14%, transparent), 0 30px 60px -24px rgba(0, 0, 0, 0.8);
  }

  .hero__phone img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: clamp(0.85rem, 1.9vw, 1.6rem);
  }

  @media (min-width: 960px) {
    .hero__panel {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      min-height: min(720px, calc(100dvh - 96px));
    }

    .hero__copy {
      justify-content: center;
      padding-block: clamp(3.5rem, 6vw, 5.5rem);
    }

    .hero__wall {
      height: auto;
    }

    .hero__wall::after {
      background:
        linear-gradient(90deg, var(--night) 0%, transparent 26%),
        linear-gradient(180deg, var(--night) 0%, transparent 16%, transparent 84%, var(--night) 100%);
    }

    .hero__grid {
      top: -22%;
      left: -6%;
      width: 118%;
    }
  }

  /* --- Work --------------------------------------------------------------- */
  .work {
    list-style: none;
    padding: 0;
    margin-top: clamp(2rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .work__item {
    position: relative;
    display: grid;
    align-content: start;
    background: var(--mist);
    border-radius: var(--r-xl);
    padding: clamp(0.65rem, 1.2vw, 0.85rem);
  }

  .work__shot {
    display: block;
    overflow: hidden;
    border-radius: calc(var(--r-xl) - 0.75rem);
    aspect-ratio: 16 / 10;
    background: var(--surface);
  }

  .work__shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform var(--dur-3) var(--ease-quart);
  }

  .work__item:hover .work__shot img {
    transform: scale(1.025);
  }

  .work__body {
    display: grid;
    gap: 0.55rem;
    padding: 1.25rem 0.85rem 0.85rem;
  }

  .work__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .work__domain {
    font-size: var(--step-3);
    letter-spacing: -0.02em;
  }

  .work__domain a {
    text-decoration: none;
  }

  /* The whole card opens the store; the domain is the one real link. */
  .work__domain a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .work__about {
    color: var(--ink-muted);
  }

  .work__theme {
    font-size: 0.9375rem;
  }

