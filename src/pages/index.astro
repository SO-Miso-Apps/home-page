---
import { getSeoMeta } from "emdash";
import type { App } from "../../emdash-env";
import Base from "../layouts/Base.astro";
import AppCard from "../components/AppCard.astro";
import CtaPanel from "../components/CtaPanel.astro";
import Faq from "../components/Faq.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import ReviewBand from "../components/ReviewBand.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { FAQ_BY_LANG } from "../faq";
import { getLang, localizeHref } from "../i18n";
import { getLocalizedCollection } from "../lib/content";
import { getWork } from "../work";

const lang = getLang(Astro.locals);

const { entries: apps, error, cacheHint } = await getLocalizedCollection<"apps", App>(
  "apps",
  { orderBy: { sort_order: "asc" } },
  lang,
);
if (error) {
  console.error("Failed to load apps:", error);
  return new Response("Unable to load apps", { status: 500 });
}
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// getSeoMeta requires a content-shaped object; the home page has no CMS entry,
// so pass an empty data shell and resolve meta from site defaults.
const seo = getSeoMeta({ data: {} }, {
  siteTitle: "Miso Apps",
  siteUrl: Astro.site?.toString() ?? Astro.url.origin,
  path: Astro.url.pathname,
});

// The home page leads with the theme service; the app catalog follows it.
// Every claim here is one the studio can show: the live storefronts in
// work.ts, the steps on /services, the apps in the CMS. No invented numbers.
const copy = {
  en: {
    title: "Shopify theme design and customization",
    chip: "Shopify theme design and customization",
    h1: { before: "Your store, ", em: "exactly", after: " as you pictured it." },
    lede: "We build new themes from scratch or rework the one you already run — home, collection, product, cart. Every part stays editable in the theme editor, so you never need a developer for a change.",
    primary: "Send a request",
    secondary: "See how we work",
    collage: ["section · banner", "section · featured products", "section · reviews"],
    work: {
      eyebrow: "Recent work",
      title: "Storefronts we've customized",
      lead: "Two Shopify stores selling today on themes we've worked on. Go and click around.",
      theme: "Theme",
      visit: "Visit store",
      newTab: "(opens in a new tab)",
      shot: (domain: string) => `Home page of ${domain}`,
    },
    services: {
      eyebrow: "Theme services",
      title: "What we can do with your theme",
      cards: [
        { title: "A new theme", body: "A storefront designed around your brand and your products, with every page you sell on: home, collection, product, cart." },
        { title: "Rework the theme you have", body: "New sections, a rebuilt layout, a fresh look for a single template — without giving up the theme you already run." },
        { title: "Faster and easier to use", body: "A pass over Core Web Vitals, keyboard navigation, contrast, and the layout shift that happens while a page loads." },
      ],
      more: "Service details",
      apps: "Need an app built around your own workflow instead?",
      appsLink: "Custom app development",
    },
    process: {
      eyebrow: "How we work",
      title: "Four steps, and you sign off on each one",
      steps: [
        { title: "Tell us what you need", body: "A few lines about your store, the theme you run, and what you want to change." },
        { title: "Review and quote", body: "We look at the live store, agree the scope, and quote before any work starts." },
        { title: "Approve on a preview", body: "Each part is shown on a preview of your theme as it's finished, so you comment before anything goes live." },
        { title: "Handover", body: "The theme is published. You keep every file, written notes, and a direct line to the person who built it." },
      ],
    },
    apps: {
      eyebrow: "Our apps",
      title: "Apps from Miso",
      lead: "Alongside theme work, we make our own apps for the Shopify App Store.",
    },
    faq: {
      eyebrow: "FAQ",
      title: "What people ask us first",
      lead: "Short answers to what comes up before a project starts. Anything else, just ask.",
    },
    cta: {
      title: "What would you change about your store?",
      body: "Describe it in a few lines. We'll reply with a scope of work and a quote.",
      primary: "Send a request",
    },
  },
  vi: {
    title: "Thiết kế và tùy chỉnh theme Shopify",
    chip: "Thiết kế và tùy chỉnh theme Shopify",
    h1: { before: "Cửa hàng của bạn, ", em: "đúng", after: " như bạn hình dung." },
    lede: "Chúng tôi làm theme mới từ đầu hoặc chỉnh lại theme bạn đang dùng — trang chủ, danh mục, sản phẩm, giỏ hàng. Mọi phần đều sửa được trong trình chỉnh sửa theme, không cần nhờ lập trình viên.",
    primary: "Gửi yêu cầu",
    secondary: "Xem cách chúng tôi làm",
    collage: ["section · banner", "section · sản phẩm nổi bật", "section · đánh giá"],
    work: {
      eyebrow: "Dự án đã làm",
      title: "Những cửa hàng chúng tôi đã chỉnh theme",
      lead: "Hai cửa hàng Shopify đang bán hàng mỗi ngày trên theme do chúng tôi chỉnh. Bạn cứ vào xem và bấm thử.",
      theme: "Theme",
      visit: "Xem cửa hàng",
      newTab: "(mở trong tab mới)",
      shot: (domain: string) => `Trang chủ của ${domain}`,
    },
    services: {
      eyebrow: "Dịch vụ theme",
      title: "Chúng tôi nhận làm gì với theme của bạn",
      cards: [
        { title: "Làm theme mới", body: "Giao diện riêng theo thương hiệu và sản phẩm của bạn, đủ mọi trang bán hàng: trang chủ, danh mục, sản phẩm, giỏ hàng." },
        { title: "Chỉnh theme đang dùng", body: "Thêm section, sửa bố cục, đổi giao diện từng trang mà không phải bỏ theme hiện tại." },
        { title: "Tăng tốc và dễ dùng hơn", body: "Rà soát Core Web Vitals, điều hướng bằng bàn phím, độ tương phản và hiện tượng giật bố cục khi tải trang." },
      ],
      more: "Chi tiết dịch vụ",
      apps: "Bạn cần một app làm riêng theo quy trình của mình?",
      appsLink: "Dịch vụ làm app theo yêu cầu",
    },
    process: {
      eyebrow: "Cách chúng tôi làm",
      title: "Bốn bước, bạn duyệt ở từng bước",
      steps: [
        { title: "Gửi mô tả", body: "Vài dòng về cửa hàng, theme đang dùng và điều bạn muốn thay đổi." },
        { title: "Khảo sát và báo giá", body: "Chúng tôi xem cửa hàng thật, chốt phạm vi và báo giá trước khi bắt tay vào làm." },
        { title: "Duyệt trên bản xem trước", body: "Phần nào xong, bạn xem ngay trên bản xem trước của theme và góp ý trước khi công khai." },
        { title: "Bàn giao", body: "Theme được xuất bản. Bạn giữ toàn bộ file, tài liệu hướng dẫn và liên hệ trực tiếp với người đã làm." },
      ],
    },
    apps: {
      eyebrow: "Ứng dụng",
      title: "Ứng dụng của Miso",
      lead: "Ngoài làm theme, chúng tôi còn có các app trên Shopify App Store.",
    },
    faq: {
      eyebrow: "Hỏi đáp",
      title: "Những câu chúng tôi hay được hỏi",
      lead: "Trả lời ngắn gọn những điều thường gặp trước khi bắt đầu dự án. Còn thắc mắc gì khác, bạn cứ hỏi thẳng chúng tôi.",
    },
    cta: {
      title: "Bạn muốn đổi gì trên cửa hàng?",
      body: "Mô tả trong vài dòng, chúng tôi sẽ phản hồi kèm phạm vi công việc và báo giá.",
      primary: "Gửi yêu cầu",
    },
  },
}[lang];

const contactHref = localizeHref("/services#request", lang);
const work = getWork(lang);
const TONES = ["peach", "tofu", "seaweed"] as const;
---

<Base title={copy.title} description={lang === "vi" ? undefined : (seo.description ?? undefined)} image={seo.ogImage ?? undefined} canonical={seo.canonical ?? undefined} robots={seo.robots ?? undefined}>
  <section class="hero" data-hero>
    <div class="container hero__copy">
      <span class="chip" data-hero-item>{copy.chip}</span>
      <h1 data-hero-item>{copy.h1.before}<em>{copy.h1.em}</em>{copy.h1.after}</h1>
      <p class="lede hero__lede" data-hero-item>{copy.lede}</p>
      <div class="hero__actions" data-hero-item>
        <a class="btn btn--brand btn--lg" href={contactHref}>
          {copy.primary}
          <svg class="btn__arrow" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
            <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a class="btn btn--ghost btn--lg" href="#process">{copy.secondary}</a>
      </div>
    </div>

    {/* A theme, drawn as the sections a merchant stacks in the editor. */}
    <div class="container collage" aria-hidden="true" data-hero-art>
      <div class="collage__block tone-seaweed collage__block--banner">
        <span class="collage__label">{copy.collage[0]}</span>
        <span class="collage__lines">
          <span class="collage__line collage__line--strong" style="width: 70%"></span>
          <span class="collage__line" style="width: 45%"></span>
          <span class="collage__pill"></span>
        </span>
      </div>
      <div class="collage__block tone-peach collage__block--products">
        <span class="collage__label">{copy.collage[1]}</span>
        <span class="collage__grid">
          <span></span><span></span><span></span><span></span>
        </span>
      </div>
      <div class="collage__block tone-tofu collage__block--reviews">
        <span class="collage__label">{copy.collage[2]}</span>
        <span class="collage__lines">
          <span class="collage__stars">★★★★★</span>
          <span class="collage__line" style="width: 90%"></span>
          <span class="collage__line" style="width: 75%"></span>
          <span class="collage__line" style="width: 55%"></span>
        </span>
      </div>
    </div>
  </section>

  <section class="section" id="work" aria-labelledby="work-title">
    <div class="container">
      <SectionHeader id="work-title" eyebrow={copy.work.eyebrow} title={copy.work.title} lead={copy.work.lead} />
      <ul class="work">
        {
          work.map((item) => (
            <li class="work__item" data-reveal>
              <div class="work__shot">
                <img
                  src={item.image.src}
                  width={item.image.width}
                  height={item.image.height}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="work__body">
                <div class="work__tags">
                  {item.tags.map((tag) => <span class="badge">{tag}</span>)}
                </div>
                <h3 class="work__domain">
                  <a href={item.url} target="_blank" rel="noopener noreferrer">
                    {item.domain}
                    <span class="sr-only"> {copy.work.newTab}</span>
                  </a>
                </h3>
                <p class="work__about">{item.about}</p>
                <p class="work__theme">
                  <span class="dim">{copy.work.theme}:</span> {item.theme}
                </p>
                <span class="work__visit" aria-hidden="true">
                  {copy.work.visit}
                  <svg viewBox="0 0 16 16" width="14" height="14" focusable="false">
                    <path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section services" id="services" aria-labelledby="services-title">
    <div class="container">
      <SectionHeader id="services-title" eyebrow={copy.services.eyebrow} title={copy.services.title} />
      <ol class="services__grid">
        {
          copy.services.cards.map((card, index) => (
            <li class:list={["service", `tone-${TONES[index % TONES.length]}`]} data-reveal>
              <span class="service__num">{String(index + 1).padStart(2, "0")}</span>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
            </li>
          ))
        }
      </ol>
      <div class="services__foot">
        <a class="btn btn--ghost" href={localizeHref("/services#custom-themes", lang)}>
          {copy.services.more}
          <svg class="btn__arrow" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" focusable="false">
            <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <p class="services__apps">
          {copy.services.apps}{" "}
          <a href={localizeHref("/services#custom-apps", lang)}>{copy.services.appsLink}</a>
        </p>
      </div>
    </div>
  </section>

  <ProcessSteps id="process" band eyebrow={copy.process.eyebrow} title={copy.process.title} steps={copy.process.steps} />

  <section class="section" id="apps" aria-labelledby="apps-title">
    <div class="container">
      <SectionHeader id="apps-title" eyebrow={copy.apps.eyebrow} title={copy.apps.title} lead={copy.apps.lead} />
      <ul class="apps">
        {
          apps.map((app, index) => (
            <li>
              <AppCard app={app} tone={(["peach", "seaweed", "brand", "tofu"] as const)[index % 4]} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ReviewBand apps={apps} />

  <Faq eyebrow={copy.faq.eyebrow} title={copy.faq.title} lead={copy.faq.lead} items={FAQ_BY_LANG[lang]} />

  <CtaPanel title={copy.cta.title} body={copy.cta.body} primary={{ label: copy.cta.primary, href: contactHref }} />
</Base>

<style>
  /* --- Hero --------------------------------------------------------------- */
  .hero {
    padding-block: clamp(3rem, 8vw, 6rem) 0;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(1.25rem, 2.4vw, 1.75rem);
  }

  h1 {
    font-size: var(--step-hero);
    line-height: 1.08;
    letter-spacing: -0.03em;
    max-width: 15ch;
  }

  .hero__lede {
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
    max-width: 58ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  /* --- Collage ------------------------------------------------------------ */
  .collage {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: end;
    gap: clamp(0.5rem, 1.5vw, 1rem);
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  .collage__block {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(0.85rem, 2vw, 1.5rem);
    border-radius: clamp(1.1rem, 2.6vw, 2rem);
  }

  .collage__block--banner {
    height: clamp(150px, 26vw, 300px);
    transform: rotate(-2deg);
  }

  .collage__block--products {
    height: clamp(180px, 31vw, 360px);
  }

  .collage__block--reviews {
    height: clamp(140px, 24vw, 280px);
    transform: rotate(2deg);
  }

  .collage__label {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--tone-muted);
  }

  .collage__lines {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .collage__line {
    display: block;
    height: 10px;
    border-radius: 6px;
    background: var(--tofu-line);
  }

  .tone-seaweed .collage__line {
    background: color-mix(in oklab, var(--seaweed-ink) 45%, transparent);
  }

  .tone-seaweed .collage__line--strong {
    height: 16px;
    background: var(--seaweed-ink);
  }

  .collage__pill {
    display: block;
    width: 34%;
    height: 28px;
    margin-top: 0.4rem;
    border-radius: var(--r-pill);
    background: var(--brand);
  }

  /* Fills what the label leaves, so the tiles never spill past the block. */
  .collage__grid {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: clamp(0.4rem, 1vw, 0.65rem);
  }

  .collage__grid span {
    border-radius: clamp(0.6rem, 1.4vw, 1.1rem);
    background: var(--surface);
  }

  .collage__stars {
    color: var(--brand);
    letter-spacing: 0.15em;
    font-size: 0.9rem;
  }

  @media (max-width: 639px) {
    .collage__label,
    .collage__stars {
      display: none;
    }
    .collage__pill {
      height: 18px;
      width: 50%;
    }
  }

  /* --- Work --------------------------------------------------------------- */
  .work {
    list-style: none;
    padding: 0;
    margin-top: clamp(2rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .work__item {
    position: relative;
    display: grid;
    align-content: start;
    background: var(--tofu);
    border-radius: var(--r-xl);
    padding: clamp(0.65rem, 1.2vw, 0.85rem);
  }

  .work__shot {
    display: block;
    overflow: hidden;
    border-radius: calc(var(--r-xl) - 0.75rem);
    aspect-ratio: 16 / 10;
    background: var(--surface);
  }

  .work__shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform var(--dur-3) var(--ease-quart);
  }

  .work__item:hover .work__shot img {
    transform: scale(1.025);
  }

  .work__body {
    display: grid;
    gap: 0.55rem;
    padding: 1.25rem 0.85rem 0.85rem;
  }

  .work__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .work__domain {
    font-size: var(--step-3);
    letter-spacing: -0.02em;
  }

  .work__domain a {
    text-decoration: none;
  }

  /* The whole card opens the store; the domain is the one real link. */
  .work__domain a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .work__about {
    color: var(--ink-muted);
  }

  .work__theme {
    font-size: 0.9375rem;
  }

  .work__visit {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.25rem;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--brand-ink);
  }

  .work__visit svg {
    transition: transform var(--dur-2) var(--ease-quart);
  }

  .work__item:hover .work__visit svg {
    transform: translate(2px, -2px);
  }

  /* --- Services ----------------------------------------------------------- */
  .services__grid {
    list-style: none;
    padding: 0;
    margin-top: clamp(2rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 1rem;
  }

  .service {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    min-height: 260px;
    padding: clamp(1.5rem, 3vw, 2rem);
    border-radius: var(--r-xl);
  }

  .service__num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.375rem;
    color: var(--tone-muted);
  }

  .tone-peach .service__num {
    color: var(--peach-ink);
  }

  .tone-seaweed .service__num {
    color: var(--seaweed-accent);
  }

  .service h3 {
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 1.75rem);
    line-height: 1.2;
  }

  .service p {
    color: var(--tone-muted);
    line-height: 1.7;
  }

  .services__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 1.75rem;
  }

  .services__apps {
    color: var(--ink-muted);
  }

  .services__apps a {
    color: var(--brand-ink);
    font-weight: 500;
    text-underline-offset: 0.2em;
  }

  /* --- Apps --------------------------------------------------------------- */
  .apps {
    list-style: none;
    padding: 0;
    margin-top: clamp(2rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
    gap: 1rem;
  }
</style>
