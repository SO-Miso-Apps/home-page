---
import { getSeoMeta } from "emdash";
import type { App } from "../../emdash-env";
import Base from "../layouts/Base.astro";
import AppCard from "../components/AppCard.astro";
import AppMark from "../components/AppMark.astro";
import CtaPanel from "../components/CtaPanel.astro";
import Faq from "../components/Faq.astro";
import Marquee from "../components/Marquee.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import ReviewBand from "../components/ReviewBand.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ServiceTracks from "../components/ServiceTracks.astro";
import StatStrip from "../components/StatStrip.astro";
import { FAQ_BY_LANG } from "../faq";
import { getLang, localizeHref } from "../i18n";
import { getLocalizedCollection } from "../lib/content";
import { SERVICES_BY_LANG } from "../services";

const lang = getLang(Astro.locals);

const { entries: apps, error, cacheHint } = await getLocalizedCollection<"apps", App>(
  "apps",
  { orderBy: { sort_order: "asc" } },
  lang,
);
if (error) {
  console.error("Failed to load apps:", error);
  return new Response("Unable to load apps", { status: 500 });
}
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// getSeoMeta requires a content-shaped object; the home page has no CMS entry,
// so pass an empty data shell and resolve meta from site defaults.
const seo = getSeoMeta({ data: {} }, {
  siteTitle: "Miso Apps",
  siteUrl: Astro.site?.toString() ?? Astro.url.origin,
  path: Astro.url.pathname,
});

// Bento rhythm: cells alternate long/short so the grid never reads as a row of
// equal boxes. Two entries or fewer fall back to a half-width pair.
const RHYTHM = [4, 2, 2, 4];
const spanFor = (index: number) => (apps.length <= 2 ? 3 : RHYTHM[index % RHYTHM.length]);

// The rating tile is computed from the catalog so it can never drift from the
// entries an editor publishes; the other three are studio claims from the
// previous site and stay as written.
const rated = apps.filter((app) => typeof app.data.rating_value === "number");
const averageRating = rated.length
  ? rated.reduce((total, app) => total + (app.data.rating_value ?? 0), 0) / rated.length
  : null;

const copy = {
  en: {
    title: "Commerce apps for stores that keep moving",
    // The site-wide default already says this in English; null keeps it.
    eyebrow: "Shopify app studio",
    h1: ["Commerce apps built for stores", "that have to keep moving."],
    lede: "Miso Apps designs and ships focused Shopify and Shopline apps for automation, conversion, and AI-readable storefront data. The work is clean, fast, and built around merchant operations.",
    viewApps: "View our apps",
    contact: "Contact us",
    listings: "App Store listings",
    live: (n: number) => `${n} live`,
    glance: "Studio at a glance",
    stats: ["Apps on the App Store", "Merchant stores reached", "Countries served", "Average app rating"],
    support: "Support 24/7",
    apps: {
      eyebrow: "Our apps",
      title: "Focused products, measurable results.",
      lead: "Every app below is live on the Shopify App Store. Each one does a single operational job properly, and each listing page is built from the same CMS entry the store team edits.",
    },
    services: {
      eyebrow: "Services",
      title: "When the catalog is close but not close enough.",
      lead: "Beyond the apps: a custom app for the workflow your team still runs by hand, and a theme built to your brand instead of stretched around someone else's. Both are scoped against your store and reviewed before launch.",
      more: "How a custom build runs",
    },
    process: {
      title: "Ship something merchants can trust on a busy Monday.",
      lead: "Four steps, in this order, every time. No long discovery decks and no handoffs to a team you never met.",
      steps: [
        { title: "Scope on your store", body: "We start from the workflow itself: order volume, who edits what, and which parts of the admin your team works around." },
        { title: "Build on the Shopify APIs", body: "Admin GraphQL, webhooks, and Functions. No brittle theme hacks, and nothing that slows the storefront down." },
        { title: "Review on a live store", body: "You test every flow on a real development store before it reaches merchants. Copy, edge cases, and permissions are settled there." },
        { title: "Ship and keep the pager on", body: "Listed on the App Store, watched for review notices and API changes, and answered by the people who wrote the code." },
      ],
    },
    faq: {
      eyebrow: "FAQ",
      title: "Questions merchants ask first.",
      lead: "Short answers to what comes up before a project starts. Anything else, ask us directly.",
    },
    cta: {
      eyebrow: "Get started",
      title: "Put an app to work on your store this week.",
      body: "Install from the App Store, or tell us which operational job is costing your team the most time.",
      primary: "Request a quote",
      secondary: "Browse the apps",
    },
  },
  vi: {
    title: "App thương mại điện tử cho cửa hàng không ngừng vận hành",
    eyebrow: "Studio app Shopify",
    h1: ["App thương mại điện tử cho những cửa hàng", "không được phép đứng yên."],
    lede: "Miso Apps thiết kế và phát hành các app Shopify, Shopline chuyên biệt cho tự động hóa, tăng chuyển đổi và dữ liệu cửa hàng mà AI đọc được. Gọn, nhanh và xây quanh cách nhà bán hàng thực sự vận hành.",
    viewApps: "Xem các app",
    contact: "Liên hệ ngay",
    listings: "App trên App Store",
    live: (n: number) => `${n} đang hoạt động`,
    glance: "Tổng quan về studio",
    stats: ["App trên App Store", "Cửa hàng đã tiếp cận", "Quốc gia phục vụ", "Điểm đánh giá trung bình"],
    support: "Hỗ trợ 24/7",
    apps: {
      eyebrow: "Sản phẩm",
      title: "Sản phẩm chuyên biệt, kết quả đo được.",
      lead: "Mọi app dưới đây đều đang có mặt trên Shopify App Store. Mỗi app làm thật tốt một việc vận hành, và mỗi trang giới thiệu được dựng từ chính nội dung CMS mà đội ngũ cập nhật.",
    },
    services: {
      eyebrow: "Dịch vụ",
      title: "Khi app có sẵn gần đúng nhưng chưa đủ đúng.",
      lead: "Ngoài các app: một app riêng cho quy trình đội của bạn vẫn làm tay, và một theme làm theo thương hiệu của bạn thay vì gò thương hiệu vào theme của người khác. Cả hai đều được khảo sát trên cửa hàng của bạn và kiểm thử trước khi ra mắt.",
      more: "Quy trình một dự án theo yêu cầu",
    },
    process: {
      title: "Làm ra thứ nhà bán hàng tin dùng cả vào ngày bận nhất.",
      lead: "Bốn bước, đúng thứ tự này, lần nào cũng vậy. Không có slide khảo sát dài dòng, không chuyển giao cho một đội bạn chưa từng gặp.",
      steps: [
        { title: "Khảo sát trên cửa hàng của bạn", body: "Chúng tôi bắt đầu từ chính quy trình: lượng đơn hàng, ai chỉnh sửa gì, và những phần nào trong admin đội của bạn đang phải đi đường vòng." },
        { title: "Xây trên API của Shopify", body: "Admin GraphQL, webhooks và Functions. Không chắp vá theme dễ vỡ, không làm chậm storefront." },
        { title: "Kiểm thử trên cửa hàng thật", body: "Bạn thử mọi luồng trên một cửa hàng phát triển trước khi tới tay khách hàng. Nội dung, trường hợp biên và phân quyền đều được chốt tại đây." },
        { title: "Ra mắt và luôn trực hỗ trợ", body: "Đăng trên App Store, theo dõi thông báo review và thay đổi API, và được trả lời bởi chính những người viết code." },
      ],
    },
    faq: {
      eyebrow: "Câu hỏi thường gặp",
      title: "Những điều nhà bán hàng hay hỏi trước tiên.",
      lead: "Trả lời ngắn cho các câu hỏi trước khi bắt đầu dự án. Câu hỏi khác, cứ hỏi trực tiếp chúng tôi.",
    },
    cta: {
      eyebrow: "Bắt đầu",
      title: "Đưa một app vào làm việc cho cửa hàng của bạn ngay tuần này.",
      body: "Cài đặt từ App Store, hoặc cho chúng tôi biết việc vận hành nào đang tốn thời gian của đội bạn nhất.",
      primary: "Yêu cầu báo giá",
      secondary: "Xem các app",
    },
  },
}[lang];

const contactHref = localizeHref("/services#request", lang);

const stats = [
  { value: String(apps.length), label: copy.stats[0] },
  { value: "10K+", label: copy.stats[1] },
  { value: "50+", label: copy.stats[2] },
  { value: averageRating ? averageRating.toFixed(1) : "—", label: copy.stats[3] },
];

const ticker = [
  ...apps.map((app) => app.data.badge).filter((badge): badge is string => Boolean(badge)),
  "Shopify",
  "Shopline",
  "Admin GraphQL",
  "Webhooks",
  copy.support,
];
---

<Base title={copy.title} description={lang === "vi" ? undefined : (seo.description ?? undefined)} image={seo.ogImage ?? undefined} canonical={seo.canonical ?? undefined} robots={seo.robots ?? undefined}>
  <section class="hero" data-hero>
    <div class="container hero__grid">
      <div class="hero__copy">
        <span class="eyebrow" data-hero-item>
          <span class="eyebrow__dot" />
          {copy.eyebrow}
        </span>
        <h1 data-hero-item>
          <span class="hero__line">{copy.h1[0]}</span>
          <span class="hero__line hero__line--dim">{copy.h1[1]}</span>
        </h1>
        <p class="lede" data-hero-item>{copy.lede}</p>
        <div class="hero__actions" data-hero-item>
          <a class="btn btn--brand btn--lg" href={contactHref}>
            {copy.contact}
            <svg class="btn__arrow" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" focusable="false">
              <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a class="btn btn--ghost btn--lg" href="#apps">{copy.viewApps}</a>
        </div>
      </div>

      <div class="hero__art" data-hero-art>
        <div class="hero__panel glass" data-float>
          <div class="hero__panel-top">
            <span class="hero__panel-label">{copy.listings}</span>
            <span class="hero__status num">
              <span class="hero__status-dot" aria-hidden="true" />
              {copy.live(apps.length)}
            </span>
          </div>

          <div class="orb-wrap">
            <div class="orb" aria-hidden="true" />
          </div>

          <ul class="hero__apps">
            {
              apps.map((app) => (
                <li class="hero__app">
                  <AppMark seed={app.id} size={30} />
                  <span class="hero__app-name">{app.data.name}</span>
                  {app.data.badge && <span class="hero__app-badge">{app.data.badge}</span>}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-label={copy.glance}>
    <div class="container">
      <Marquee items={ticker} />
      <StatStrip stats={stats} class="hero__stats" />
    </div>
  </section>

  <section class="section" id="apps" aria-labelledby="apps-title">
    <div class="container">
      <SectionHeader id="apps-title" eyebrow={copy.apps.eyebrow} title={copy.apps.title} lead={copy.apps.lead} />
      <div class="bento">
        {
          apps.map((app, index) => {
            const span = spanFor(index);
            return (
              <div class="bento__cell" data-span={span}>
                <AppCard app={app} variant={span >= 4 ? "wide" : "narrow"} />
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section" id="services" aria-labelledby="services-title">
    <div class="container">
      <SectionHeader id="services-title" eyebrow={copy.services.eyebrow} title={copy.services.title} lead={copy.services.lead} />
      <div class="tracks-wrap">
        <ServiceTracks tracks={SERVICES_BY_LANG[lang]} />
      </div>
      <div class="services__more">
        <a class="btn btn--ghost" href={localizeHref("/services", lang)}>
          {copy.services.more}
          <svg class="btn__arrow" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" focusable="false">
            <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <ReviewBand apps={apps} />

  <ProcessSteps title={copy.process.title} lead={copy.process.lead} steps={copy.process.steps} />

  <Faq eyebrow={copy.faq.eyebrow} title={copy.faq.title} lead={copy.faq.lead} items={FAQ_BY_LANG[lang]} />

  <CtaPanel
    seed="home-cta"
    eyebrow={copy.cta.eyebrow}
    title={copy.cta.title}
    body={copy.cta.body}
    primary={{ label: copy.cta.primary, href: contactHref }}
    secondary={{ label: copy.cta.secondary, href: "#apps" }}
  />
</Base>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(1rem, 3vw, 2rem);
  }

  /* Ambient wash behind the hero copy — one soft radial, no outer glow. Kept
     inside the container's horizontal bounds so it can never widen the page. */
  .hero::before {
    content: "";
    position: absolute;
    inset: -20% 0 auto 0;
    height: 70%;
    background: radial-gradient(
      ellipse 72% 62% at 18% 0%,
      color-mix(in oklab, var(--brand) 13%, transparent),
      transparent 70%
    );
    pointer-events: none;
    z-index: -1;
  }

  .hero__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }

  .hero__copy {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
  }

  .hero__line {
    display: block;
  }

  .hero__line--dim {
    color: var(--ink-subtle);
  }

  h1 {
    font-size: var(--step-5);
    letter-spacing: -0.035em;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .hero__art {
    display: grid;
  }

  .hero__panel {
    display: grid;
    gap: 1.25rem;
    padding: 1.25rem;
    border-radius: var(--r-2xl);
  }

  .hero__panel-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .hero__panel-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-subtle);
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    color: var(--brand-ink);
  }

  .hero__status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 3px var(--brand-soft);
  }

  /* --- Orb: the one piece of pure decoration in the hero ---------------- */
  @property --orb-angle {
    syntax: "<angle>";
    inherits: false;
    initial-value: 0deg;
  }

  .orb-wrap {
    position: relative;
    display: grid;
    place-items: center;
    padding-block: 0.5rem;
  }

  .orb-wrap::before {
    content: "";
    position: absolute;
    inset: 6%;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in oklab, var(--brand) 26%, transparent), transparent 62%);
    filter: blur(28px);
    pointer-events: none;
  }

  .orb {
    position: relative;
    width: min(58%, 190px);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(circle at 32% 26%, color-mix(in oklab, var(--brand) 32%, #ffffff), transparent 46%),
      radial-gradient(circle at 74% 78%, color-mix(in oklab, var(--brand-hover) 90%, transparent), transparent 60%),
      linear-gradient(
        160deg,
        color-mix(in oklab, var(--brand) 38%, var(--canvas-deep)),
        color-mix(in oklab, var(--brand-hover) 58%, var(--canvas-deep))
      );
  }

  /* Kept on a pseudo-element so browsers without @property still render the
     base gradients above instead of dropping an invalid background list. */
  .orb::before {
    content: "";
    position: absolute;
    inset: -10%;
    background: conic-gradient(
      from var(--orb-angle) at 42% 58%,
      transparent,
      color-mix(in oklab, var(--brand) 62%, transparent) 18%,
      transparent 42%,
      color-mix(in oklab, var(--brand-on-dark) 48%, transparent) 66%,
      transparent 88%
    );
    filter: blur(14px) saturate(1.2);
    animation: orb-spin 26s linear infinite;
  }

  .orb::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.2),
      inset 0 10px 22px rgba(255, 255, 255, 0.18),
      inset 0 -16px 30px rgba(0, 0, 0, 0.3);
  }

  @keyframes orb-spin {
    to {
      --orb-angle: 360deg;
    }
  }

  .hero__apps {
    display: grid;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
  }

  .hero__app {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.55rem 0.5rem;
    border-radius: var(--r-sm);
    transition: background-color var(--dur-2) var(--ease-quart);
  }

  .hero__app:hover {
    background: var(--surface-2);
  }

  .hero__app-name {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hero__app-badge {
    margin-left: auto;
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-subtle);
  }

  .hero__stats {
    margin-top: 2rem;
  }

  /* --- Bento ------------------------------------------------------------ */
  .bento {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  .bento__cell {
    grid-column: span 6;
  }

  @media (min-width: 700px) {
    .bento__cell[data-span="2"] {
      grid-column: span 3;
    }
    .bento__cell[data-span="3"] {
      grid-column: span 3;
    }
    .bento__cell[data-span="4"] {
      grid-column: span 6;
    }
  }

  @media (min-width: 1040px) {
    .bento__cell[data-span="2"] {
      grid-column: span 2;
    }
    .bento__cell[data-span="3"] {
      grid-column: span 3;
    }
    .bento__cell[data-span="4"] {
      grid-column: span 4;
    }
  }

  @media (min-width: 960px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    }
  }

  .tracks-wrap {
    margin-top: 2.5rem;
  }

  .services__more {
    margin-top: 2rem;
  }
</style>
