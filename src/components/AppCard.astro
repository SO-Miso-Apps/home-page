---
import type { ContentEntry } from "emdash";
import type { App } from "../../emdash-env";
import { Image } from "emdash/ui";
import AppMark from "./AppMark.astro";
import { getLang, localizeHref } from "../i18n";

interface Props {
  app: ContentEntry<App>;
  /** Ground for the icon tile, cycled by the parent list. */
  tone?: "peach" | "seaweed" | "brand" | "tofu";
  class?: string;
}

const { app, tone = "peach", class: className } = Astro.props;
const data = app.data;
const lang = getLang(Astro.locals);
const href = localizeHref(`/apps/${app.id}`, lang);
---

<article class:list={["app-card", className]} data-reveal>
  <div class:list={["app-card__tile", `app-card__tile--${tone}`]} aria-hidden="true">
    {data.icon ? <Image image={data.icon} width={44} height={44} alt="" /> : <AppMark seed={app.id} size={64} tone={tone} class="app-card__mark" />}
  </div>

  <div class="app-card__body">
    <h3 class="app-card__name"><a href={href}>{data.name}</a></h3>
    <p class="app-card__tagline">{data.tagline}</p>
  </div>

  <svg class="app-card__arrow" viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" focusable="false">
    <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</article>

<style>
  .app-card {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.25rem;
    height: 100%;
    padding: 1.35rem;
    background: var(--surface);
    border: 1px solid var(--tofu-line);
    border-radius: var(--r-lg);
    transition:
      transform var(--dur-2) var(--ease-quart),
      box-shadow var(--dur-2) var(--ease-quart),
      border-color var(--dur-2) var(--ease-quart);
  }

  .app-card:hover {
    transform: translateY(-2px);
    border-color: var(--brand-line);
    box-shadow: var(--shadow-2);
  }

  .app-card__tile {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: var(--r-md);
    overflow: hidden;
  }

  .app-card__tile :global(.app-card__mark) {
    width: 100%;
    height: 100%;
    border-radius: inherit;
  }

  .app-card__tile :global(img) {
    display: block;
    border-radius: var(--r-sm);
  }

  .app-card__tile--peach {
    background: var(--peach);
  }
  .app-card__tile--seaweed {
    background: var(--seaweed);
  }
  .app-card__tile--brand {
    background: var(--brand);
  }
  .app-card__tile--tofu {
    background: var(--tofu);
  }

  .app-card__body {
    display: grid;
    gap: 0.3rem;
  }

  .app-card__name {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .app-card__name a {
    text-decoration: none;
  }

  /* One click target for the whole card without duplicating the link. */
  .app-card__name a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .app-card__tagline {
    color: var(--ink-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .app-card__arrow {
    color: var(--ink-subtle);
    transition:
      transform var(--dur-2) var(--ease-quart),
      color var(--dur-2) var(--ease-quart);
  }

  .app-card:hover .app-card__arrow {
    color: var(--brand-ink);
    transform: translateX(3px);
  }

  @media (max-width: 479px) {
    .app-card {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 1rem;
      padding: 1.1rem;
    }
    .app-card__tile {
      width: 52px;
      height: 52px;
    }
    .app-card__arrow {
      display: none;
    }
  }
</style>
