---
interface Step {
  title: string;
  body: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  steps: Step[];
}

const { eyebrow = "How we work", title, lead, steps } = Astro.props;
---

<section class="section" aria-labelledby="process-title">
  <div class="container">
    <div class="head" data-reveal>
      <span class="eyebrow">
        <span class="eyebrow__dot" />
        {eyebrow}
      </span>
      <h2 id="process-title">{title}</h2>
      {lead && <p class="lede">{lead}</p>}
    </div>

    <div class="steps" data-steps>
      <div class="steps__track" aria-hidden="true">
        <span class="steps__rail" data-steps-line />
      </div>
      <ol class="steps__list">
        {
          steps.map((step, index) => (
            <li class="steps__item" data-reveal>
              <span class="steps__dot" aria-hidden="true" />
              <span class="steps__index num">{String(index + 1).padStart(2, "0")}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .head {
    display: grid;
    gap: 0.7rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
    max-width: 58ch;
  }
  .head h2 {
    font-size: var(--step-4);
  }
  .steps {
    position: relative;
  }
  .steps__track {
    position: absolute;
    top: 5px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--line);
    display: none;
  }
  .steps__rail {
    display: block;
    height: 100%;
    background: linear-gradient(to right, var(--brand), var(--brand-line));
    transform: scaleX(0);
  }
  .steps__list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 2rem clamp(1.5rem, 3vw, 2.5rem);
  }
  .steps__item {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding-top: 1.5rem;
    position: relative;
  }
  .steps__dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--surface);
    border: 2px solid var(--brand);
    box-shadow: 0 0 0 4px var(--canvas);
  }
  .steps__index {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--ink-subtle);
  }
  .steps__item h3 {
    font-size: var(--step-1);
  }
  .steps__item p {
    color: var(--ink-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  @media (min-width: 760px) {
    .steps__track {
      display: block;
    }
    .steps__item {
      padding-top: 2rem;
    }
  }
</style>
