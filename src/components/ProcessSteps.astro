---
import { getLang } from "../i18n";

interface Step {
  title: string;
  body: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  steps: Step[];
  id?: string;
  /** Sit the steps on a tofu band instead of the page ground. */
  band?: boolean;
}

const lang = getLang(Astro.locals);
const { eyebrow = lang === "vi" ? "Cách chúng tôi làm" : "How we work", title, lead, steps, id, band = false } = Astro.props;
// First step in miso, last in seaweed, the ones between plain: the start and
// the handover are the two moments the client acts on.
const toneFor = (index: number) => (index === 0 ? "brand" : index === steps.length - 1 ? "seaweed" : "plain");
---

<section class:list={["section", "process", { band }]} id={id} aria-labelledby="process-title">
  <div class="container">
    <div class="head" data-reveal>
      <span class="eyebrow">
        <span class="eyebrow__dot" />
        {eyebrow}
      </span>
      <h2 id="process-title">{title}</h2>
      {lead && <p class="lede">{lead}</p>}
    </div>

    <ol class="steps">
      {
        steps.map((step, index) => (
          <li class="steps__item" data-reveal>
            <span class:list={["steps__num", `steps__num--${toneFor(index)}`]} aria-hidden="true">
              {index + 1}
            </span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process {
    scroll-margin-top: 4rem;
  }
  .head {
    display: grid;
    gap: 0.75rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
    max-width: 58ch;
  }
  .head h2 {
    font-size: var(--step-4);
  }
  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    gap: 2rem clamp(1.5rem, 3vw, 2.5rem);
  }
  .steps__item {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }
  .steps__num {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-bottom: 0.25rem;
    border-radius: var(--r-pill);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    background: var(--tofu);
    color: var(--ink);
  }
  .band .steps__num--plain {
    background: var(--surface);
  }
  .steps__num--brand {
    background: var(--brand);
    color: var(--brand-fg);
  }
  .steps__num--seaweed {
    background: var(--seaweed);
    color: var(--seaweed-ink);
  }
  .steps__item h3 {
    font-family: var(--font-body);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .steps__item p {
    color: var(--ink-muted);
    line-height: 1.65;
  }
</style>
