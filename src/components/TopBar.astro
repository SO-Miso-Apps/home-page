---
import LangSwitch from "./LangSwitch.astro";
import { getLang } from "../i18n";
import { CONTACT_EMAIL, CONTACT_PHONE, CONTACT_PHONE_HREF } from "../site";

// The contact line above the header: how to reach a person, in the order
// people reach for them, and the language switch at the far end. Scrolls away
// with the page — only the header below it is sticky.
const lang = getLang(Astro.locals);
const copy = {
  en: { label: "Contact and language", phone: "Call", email: "Email", origin: "Hanoi, Vietnam", reply: "Replies within one working day" },
  vi: { label: "Liên hệ và ngôn ngữ", phone: "Gọi", email: "Email", origin: "Hà Nội, Việt Nam", reply: "Phản hồi trong một ngày làm việc" },
}[lang];
---

<div class="topbar" role="region" aria-label={copy.label}>
  <div class="container topbar__inner">
    <ul class="topbar__list">
      <li>
        <a href={CONTACT_PHONE_HREF}>
          <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" focusable="false">
            <path d="M5.2 2.5 3.4 2.6c-.6 0-1 .5-1 1.1.3 5.3 4.6 9.6 9.9 9.9.6 0 1.1-.4 1.1-1l.1-1.8c0-.4-.3-.8-.7-.9l-2-.6c-.3-.1-.7 0-.9.3l-.7.9A7.6 7.6 0 0 1 5.1 6.4l.9-.7c.3-.2.4-.6.3-.9l-.6-2c-.1-.2-.3-.3-.5-.3Z" />
          </svg>
          <span class="sr-only">{copy.phone}: </span>
          <span class="num">{CONTACT_PHONE}</span>
        </a>
      </li>
      <li>
        <a href={`mailto:${CONTACT_EMAIL}`}>
          <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" focusable="false">
            <rect x="2" y="3.5" width="12" height="9" rx="1.6" />
            <path d="m2.6 4.4 5.4 4.1 5.4-4.1" />
          </svg>
          <span class="sr-only">{copy.email}: </span>
          {CONTACT_EMAIL}
        </a>
      </li>
      <li class="topbar__wide">
        <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" focusable="false">
          <path d="M8 14s4.5-4.1 4.5-7.6A4.5 4.5 0 0 0 3.5 6.4C3.5 9.9 8 14 8 14Z" />
          <circle cx="8" cy="6.5" r="1.6" />
        </svg>
        {copy.origin}
      </li>
      <li class="topbar__wide topbar__reply">
        <span class="topbar__pulse" aria-hidden="true"></span>
        {copy.reply}
      </li>
    </ul>
    <LangSwitch />
  </div>
</div>

<style>
  .topbar {
    border-bottom: 1px solid var(--line);
    background: var(--surface);
    font-size: 0.8125rem;
    color: var(--ink-muted);
  }

  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 40px;
  }

  .topbar__list {
    display: flex;
    align-items: center;
    gap: 0.25rem 1.25rem;
    min-width: 0;
    list-style: none;
    padding: 0;
  }

  .topbar__list li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
  }

  .topbar__list a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 32px;
    color: inherit;
    text-decoration: none;
    transition: color var(--dur-2) var(--ease-quart);
  }

  .topbar__list a:hover {
    color: var(--brand-ink);
  }

  .topbar svg {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    color: var(--ink-subtle);
  }

  .topbar__reply {
    color: var(--ink-subtle);
  }

  .topbar__pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand);
    box-shadow: 0 0 0 3px var(--brand-soft);
  }

  .topbar__wide {
    display: none !important;
  }

  @media (min-width: 760px) {
    .topbar__wide {
      display: inline-flex !important;
    }
  }

  /* Phone only on the narrowest screens: the address is one tap further, in
     the footer, and the switch must never wrap under it. */
  @media (max-width: 479px) {
    .topbar__list li:nth-child(2) {
      display: none;
    }
  }
</style>
