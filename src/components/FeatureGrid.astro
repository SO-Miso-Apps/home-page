---
import type { App } from "../../emdash-env";
import { getLang } from "../i18n";

interface Props {
  features?: App["features"] | null;
}

const { features } = Astro.props;
const rows = features ?? [];
const copy = {
  en: { eyebrow: "What it does", title: "Features" },
  vi: { eyebrow: "App làm được gì", title: "Tính năng" },
}[getLang(Astro.locals)];
---

{
  rows.length > 0 && (
    <section class="section" aria-labelledby="features-title">
      <div class="container">
        <div class="head" data-reveal>
          <span class="eyebrow">
            <span class="eyebrow__dot" />
            {copy.eyebrow}
          </span>
          <h2 id="features-title">{copy.title}</h2>
        </div>

        <ol class="features">
          {rows.map((feature, index) => (
            <li class="features__row" data-reveal>
              <span class="features__num" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <div class="features__body">
                <h3>{feature.title}</h3>
                <p>{feature.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}

<style>
  .head {
    display: grid;
    gap: 0.6rem;
    margin-bottom: 2.5rem;
  }
  .head h2 {
    font-size: var(--step-3);
  }
  /* Tofu cards, two columns at most — the same ground the FAQ and the
     services needs list sit on. */
  .features {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
  }
  .features__row {
    display: flex;
    gap: 1.25rem;
    align-items: baseline;
    padding: 1.5rem 1.6rem;
    border-radius: var(--r-lg);
    background: var(--tofu);
  }
  .features__num {
    flex: none;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1;
    color: var(--brand-ink);
  }
  .features__body h3 {
    font-size: var(--step-1);
    margin-bottom: 0.4rem;
  }
  .features__body p {
    color: var(--ink-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  @media (min-width: 760px) {
    .features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
