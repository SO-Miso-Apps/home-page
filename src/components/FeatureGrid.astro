---
import type { App } from "../../emdash-env";

interface Props {
  features?: App["features"] | null;
}

const { features } = Astro.props;
const rows = features ?? [];
---

{
  rows.length > 0 && (
    <section class="section" aria-labelledby="features-title">
      <div class="container">
        <div class="head" data-reveal>
          <span class="eyebrow">
            <span class="eyebrow__dot" />
            What it does
          </span>
          <h2 id="features-title">Features</h2>
        </div>

        <ol class="features">
          {rows.map((feature, index) => (
            <li class="features__row" data-reveal>
              <span class="features__num num">{String(index + 1).padStart(2, "0")}</span>
              <div class="features__body">
                <h3>{feature.title}</h3>
                <p>{feature.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}

<style>
  .head {
    display: grid;
    gap: 0.6rem;
    margin-bottom: 2.5rem;
  }
  .head h2 {
    font-size: var(--step-3);
  }
  /* Hairline-separated cells, not boxes: the grid reads as one surface. Two
     columns at most — a fixed three-across feature row is the generic pattern
     this design deliberately avoids. */
  .features {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: clamp(1.5rem, 4vw, 3.5rem);
  }
  .features__row {
    display: flex;
    gap: 1.25rem;
    align-items: baseline;
    padding-block: 1.6rem;
    border-top: 1px solid var(--line);
  }
  .features__num {
    color: var(--brand-ink);
    font-size: 0.8125rem;
    flex: none;
    padding-top: 0.2rem;
  }
  .features__body h3 {
    font-size: var(--step-1);
    margin-bottom: 0.4rem;
  }
  .features__body p {
    color: var(--ink-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  @media (min-width: 760px) {
    .features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
