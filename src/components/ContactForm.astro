---
import { CONTACT_COPY, HONEYPOT_FIELD, optionsFor } from "../lib/contact";
import { getLang } from "../i18n";
import { CONTACT_EMAIL } from "../site";
import { findPlan, planMessage } from "../pricing";

/**
 * Contact form. Posts to /api/contact.
 *
 * Progressive enhancement, not a JavaScript requirement: with `method`/`action`
 * set, a submit without JS does a real form post and the route answers with a
 * 303 back to `#request`, where the `?contact=` state renders the banner below.
 * The client module upgrades that to an in-place submit with per-field errors.
 */

const lang = getLang(Astro.locals);
const say = CONTACT_COPY[lang];
const options = optionsFor(lang);

// Only the four states the route redirects with; anything else is ignored.
const state = Astro.url.searchParams.get("contact");
const banners: Record<string, { tone: "ok" | "error"; message: string }> = {
  ok: { tone: "ok", message: say.ok },
  invalid: { tone: "error", message: say.invalid },
  limited: { tone: "error", message: say.limited },
  failed: { tone: "error", message: say.failed },
};
const banner = state ? banners[state] : undefined;

// A pricing card links here with `?plan=`; its message opens with the plan so
// the visitor only has to add the details.
const plan = findPlan(Astro.url.searchParams.get("plan"));
const messageStart = plan ? planMessage(plan, lang) : "";

const fields: {
  name: string;
  label: string;
  type: "text" | "email";
  required: boolean;
  autocomplete?: string;
  placeholder?: string;
}[] = [
  { name: "name", label: say.fields.name, type: "text", required: true, autocomplete: "name" },
  { name: "email", label: say.fields.email, type: "email", required: true, autocomplete: "email" },
  {
    name: "store_url",
    label: say.fields.store,
    type: "text",
    required: false,
    placeholder: "yourstore.myshopify.com",
  },
  {
    name: "deadline",
    label: say.fields.deadline,
    type: "text",
    required: false,
    placeholder: say.fields.deadlineHint,
  },
];
---

<form
  class="contact"
  method="post"
  action="/api/contact"
  data-contact-form
  data-msg-sending={say.sending}
  data-msg-check={say.checkFields}
  data-msg-retry={say.retry}
  data-msg-offline={say.offline}
>
  {/* Which language the route answers and redirects in. */}
  <input type="hidden" name="lang" value={lang} />

  {/* Set by the client module; the route only enforces the delay when present. */}
  <input type="hidden" name="started_at" value="" data-contact-started />

  {/* Bots fill it, people never see it. */}
  <div class="contact__trap" aria-hidden="true">
    <label for="contact-company">{say.trap}</label>
    <input id="contact-company" type="text" name={HONEYPOT_FIELD} tabindex="-1" autocomplete="off" />
  </div>

  {
    banner && (
      <p
        class:list={["contact__banner", `contact__banner--${banner.tone}`]}
        role={banner.tone === "error" ? "alert" : "status"}
      >
        {banner.message}
      </p>
    )
  }

  <div class="contact__grid">
    {
      fields.map((field) => (
        <p class="field">
          <label for={`contact-${field.name}`}>{field.label}</label>
          <input
            id={`contact-${field.name}`}
            name={field.name}
            type={field.type}
            required={field.required}
            placeholder={field.placeholder}
            autocomplete={field.autocomplete}
            aria-describedby={`contact-${field.name}-error`}
          />
          <span class="field__error" id={`contact-${field.name}-error`} data-contact-error={field.name} />
        </p>
      ))
    }

    <p class="field">
      <label for="contact-service">{say.service}</label>
      <select
        id="contact-service"
        name="service"
        required
        aria-describedby="contact-service-error"
      >
        <option value="">{say.chooseService}</option>
        {options.service.map((option) => <option value={option.value}>{option.label}</option>)}
      </select>
      <span class="field__error" id="contact-service-error" data-contact-error="service" />
    </p>

    <p class="field">
      <label for="contact-budget">{say.budget}</label>
      <select id="contact-budget" name="budget" aria-describedby="contact-budget-error">
        {options.budget.map((option) => <option value={option.value}>{option.label}</option>)}
      </select>
      <span class="field__error" id="contact-budget-error" data-contact-error="budget" />
    </p>
  </div>

  <p class="field">
    <label for="contact-message">{say.message}</label>
    <textarea
      id="contact-message"
      name="message"
      required
      minlength="10"
      maxlength="4000"
      rows="6"
      placeholder={say.messageHint}
      aria-describedby="contact-message-error">{messageStart}</textarea>
    <span class="field__error" id="contact-message-error" data-contact-error="message" />
  </p>

  <div class="contact__foot">
    <button class="btn btn--brand btn--lg" type="submit" data-contact-submit>
      {say.submit}
      <svg class="btn__arrow" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" focusable="false">
        <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <p class="contact__note">
      {say.orEmail} <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> {say.sameInbox}
    </p>
  </div>

  {/* Filled in by the client module once the route accepts the request. */}
  <p class="contact__note" data-contact-status role="status" aria-live="polite"></p>
</form>

<div class="contact__done" data-contact-done hidden>
  <p class="contact__done-title">{say.doneTitle}</p>
  <p class="contact__done-body">
    {say.doneBefore} <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>{say.doneAfter}
  </p>
</div>

<style>
  .contact {
    display: grid;
    gap: 1.5rem;
  }
  /* `display: grid` above outranks the user agent's `[hidden]` rule. */
  .contact[hidden] {
    display: none;
  }
  /* Off-canvas rather than hidden: `display: none` and `visibility: hidden` are
     both skipped by the bots that fill this field. */
  .contact__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem 1.5rem;
  }
  .field {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }
  .field label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
  }
  /* Filled inputs on white, so the form reads clearly on the tofu band. */
  .field :is(input, select, textarea) {
    width: 100%;
    min-height: 48px;
    padding: 0.7rem 1rem;
    font: inherit;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--tofu-line);
    border-radius: var(--r-md);
    transition: border-color var(--dur-2) var(--ease-quart);
  }
  .field select {
    cursor: pointer;
  }
  .field textarea {
    min-height: 9rem;
    resize: vertical;
    line-height: 1.65;
  }
  .field :is(input, select, textarea)::placeholder {
    color: var(--ink-subtle);
  }
  .field :is(input, select, textarea):hover {
    border-color: var(--line-strong);
  }
  .field :is(input, select, textarea):focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
    border-color: var(--brand);
  }
  .field :is(input, select, textarea)[aria-invalid="true"] {
    border-color: var(--danger);
  }
  .field__error:empty {
    display: none;
  }
  .field__error {
    font-size: 0.8125rem;
    color: var(--danger);
  }
  .contact__banner {
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--tofu-line);
    border-left: 3px solid var(--brand);
    border-radius: var(--r-md);
    background: var(--surface);
    font-size: 0.9375rem;
    color: var(--ink);
  }
  .contact__banner--error {
    border-left-color: var(--danger);
  }
  .contact__foot {
    display: grid;
    gap: 0.85rem;
    align-items: center;
    justify-items: start;
  }
  .contact__note {
    margin: 0;
    font-size: 0.875rem;
    color: var(--ink-muted);
  }
  .contact__done {
    display: grid;
    gap: 0.6rem;
    padding: clamp(1.5rem, 3vw, 2rem);
    border-radius: var(--r-lg);
    background: var(--surface);
  }
  .contact__done[hidden] {
    display: none;
  }
  .contact__done-title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .contact__done-body {
    margin: 0;
    max-width: 52ch;
    color: var(--ink-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  @media (min-width: 700px) {
    .contact__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .contact__foot {
      grid-template-columns: auto minmax(0, 1fr);
    }
  }
</style>

<script>
  import "../scripts/contact";
</script>
