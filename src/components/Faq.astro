---
import SectionHeader from "./SectionHeader.astro";
import type { FaqItem } from "../faq";

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  items: FaqItem[];
  id?: string;
}

// Native <details>: keyboard, find-in-page and no-JS all work, and each answer
// stays in the HTML for crawlers. The first one starts open so the section
// never reads as a wall of closed rows.
const { eyebrow, title, lead, items, id = "faq" } = Astro.props;
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="container faq">
    <SectionHeader id={`${id}-title`} eyebrow={eyebrow} title={title} lead={lead} class="faq__head" />
    <div class="faq__list" data-reveal>
      {
        items.map((item, index) => (
          <details class="faq__item" open={index === 0}>
            <summary class="faq__q">
              <span class="faq__num num" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <span class="faq__text">{item.question}</span>
              <span class="faq__icon" aria-hidden="true" />
            </summary>
            <p class="faq__a">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 960px) {
    .faq {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 4rem;
    }

    .faq :global(.faq__head) {
      position: sticky;
      top: 96px;
    }
  }

  .faq__list {
    border-top: 1px solid var(--line);
  }

  .faq__item {
    border-bottom: 1px solid var(--line);
  }

  .faq__q {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    min-height: 64px;
    padding-block: 1rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ink-subtle);
  }

  .faq__icon {
    position: relative;
    width: 28px;
    height: 28px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--surface);
    transition:
      transform var(--dur-2) var(--ease-spring),
      background-color var(--dur-2) var(--ease-quart);
  }

  .faq__icon::before,
  .faq__icon::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10px;
    height: 1.5px;
    border-radius: 2px;
    background: var(--ink-muted);
    transform: translate(-50%, -50%);
  }

  .faq__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .faq__item[open] .faq__icon {
    transform: rotate(45deg);
    background: var(--brand-soft);
  }

  .faq__q:hover .faq__icon {
    background: var(--surface-2);
  }

  .faq__a {
    max-width: var(--measure);
    padding: 0 2.75rem 1.5rem 2.25rem;
    color: var(--ink-muted);
  }

  @media (max-width: 559px) {
    .faq__a {
      padding-left: 0;
      padding-right: 0;
    }
  }
</style>
