---
interface Stat {
  value: string;
  label: string;
}

interface Props {
  stats: Stat[];
  class?: string;
}

const { stats, class: className } = Astro.props;
---

<dl class:list={["stats", className]} data-reveal>
  {
    stats.map((stat) => (
      <div class="stats__item">
        <dt class="stats__label">{stat.label}</dt>
        <dd class="stats__value num">{stat.value}</dd>
      </div>
    ))
  }
</dl>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(50%, 150px), 1fr));
    margin: 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .stats__item {
    display: grid;
    gap: 0.35rem;
    padding: 1.35rem 1.25rem 1.35rem 0;
    border-left: 1px solid var(--line);
    padding-left: 1.25rem;
  }
  .stats__item:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .stats__label {
    font-size: 0.8125rem;
    color: var(--ink-subtle);
    order: 2;
  }
  .stats__value {
    margin: 0;
    order: 1;
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
</style>
