---
import type { ServiceTrack } from "../services";
import { getLang } from "../i18n";

interface Props {
  tracks: ServiceTrack[];
  class?: string;
}

// Each track in full on /services: the stack line, what the client ends up
// owning, who the track fits and a link to the request form. The first track
// (theme work, the one the studio leads with) sits on peach, the rest on tofu.
const { tracks, class: className } = Astro.props;
const lang = getLang(Astro.locals);
const copy = {
  en: { fits: "A good fit for:", quote: "Ask for a quote" },
  vi: { fits: "Phù hợp với:", quote: "Nhận báo giá" },
}[lang];
---

<ol class:list={["tracks", className]} data-reveal>
  {
    tracks.map((track, index) => (
      <li class:list={["track", index === 0 ? "tone-peach" : "tone-tofu"]} id={track.id}>
        <span class="track__num" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
        <h3 class="track__title">{track.title}</h3>
        <p class="track__summary">{track.summary}</p>
        <p class="track__stack">{track.stack}</p>
        <ul class="track__list">
          {track.deliverables.map((item) => (
            <li class="track__item">
              <svg class="track__tick" viewBox="0 0 14 14" width="13" height="13" aria-hidden="true" focusable="false">
                <path d="M2.5 7.5 5.5 10.5 11.5 3.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <p class="track__best">
          <strong>{copy.fits}</strong> {track.bestFor}
        </p>
        <a class:list={["btn", index === 0 ? "btn--brand" : "btn--primary", "track__link"]} href="#request" data-contact-service={track.id}>
          {copy.quote}
          <svg class="btn__arrow" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
            <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .tracks {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }
  .track {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    border-radius: var(--r-xl);
    /* Clears the sticky header when a home-page link lands on the anchor. */
    scroll-margin-top: 6rem;
  }
  .track__num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 2.25rem;
    font-weight: 500;
    line-height: 1;
    color: var(--brand-ink);
  }
  .track__title {
    margin-top: 1rem;
    font-size: var(--step-3);
    letter-spacing: -0.025em;
  }
  .track__summary {
    margin-top: 0.75rem;
    max-width: 54ch;
    color: var(--tone-muted);
    line-height: 1.65;
  }
  .track__stack {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tone-muted);
  }
  .track__list {
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
    display: grid;
    gap: 0.75rem;
  }
  .track__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.65rem;
    color: var(--tone-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .track__tick {
    margin-top: 0.3rem;
    color: var(--brand-ink);
  }
  .track__best {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in oklab, currentColor 16%, transparent);
    color: var(--tone-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .track__best strong {
    color: inherit;
    font-weight: 600;
  }
  .tone-peach .track__best strong {
    color: var(--peach-ink);
  }
  .tone-tofu .track__best strong {
    color: var(--ink);
  }
  /* Pinned to the card's foot so both buttons line up side by side. */
  .track__best {
    margin-bottom: 1.5rem;
  }
  .track__link {
    margin-top: auto;
  }

  @media (min-width: 860px) {
    .tracks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
