---
import type { ServiceTrack } from "../services";

interface Props {
  tracks: ServiceTrack[];
  /**
   * `compact` is the home-page summary: number, title (linking to its anchor on
   * /services) and one sentence. `full` adds the stack line, what the client
   * ends up owning, who the track fits and a link to the request form.
   */
  variant?: "compact" | "full";
  class?: string;
}

const { tracks, variant = "compact", class: className } = Astro.props;
---

<ol class:list={["tracks", `tracks--${variant}`, className]} data-reveal>
  {
    tracks.map((track, index) => (
      <li class="track" id={track.id}>
        <span class="track__num num">{String(index + 1).padStart(2, "0")}</span>
        <div class="track__body">
          <h3 class="track__title">
            {variant === "compact" ? <a href={`/services#${track.id}`}>{track.title}</a> : track.title}
          </h3>
          <p class="track__summary">{track.summary}</p>

          {variant === "full" && (
            <>
              <p class="track__stack">{track.stack}</p>
              <ul class="track__list">
                {track.deliverables.map((item) => (
                  <li class="track__item">
                    <svg class="track__tick" viewBox="0 0 14 14" width="13" height="13" aria-hidden="true" focusable="false">
                      <path d="M2.5 7.5 5.5 10.5 11.5 3.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              <p class="track__best">
                <strong>Fits:</strong> {track.bestFor}
              </p>
              <a class="track__link" href="#request" data-contact-service={track.id}>
                Request a quote
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
                  <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  /* Hairline cells with at most two columns — the same rule the feature list
     follows, so the page reads as one surface instead of a row of boxes. */
  .tracks {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: clamp(1.5rem, 4vw, 3.5rem);
  }
  .track {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.5rem 1.25rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--line);
    /* Clears the sticky header when a home-page link lands on the anchor. */
    scroll-margin-top: 6rem;
  }
  .track__num {
    color: var(--brand-ink);
    font-size: 0.8125rem;
    padding-top: 0.3rem;
  }
  .track__title {
    font-size: var(--step-2);
    letter-spacing: -0.025em;
  }
  .track__title a {
    color: inherit;
    text-decoration: none;
  }
  .track__title a:hover {
    color: var(--brand-ink);
  }
  .track__summary {
    margin-top: 0.6rem;
    max-width: 54ch;
    color: var(--ink-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
  }
  .track__stack {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-subtle);
  }
  .track__list {
    list-style: none;
    padding: 0;
    margin-top: 1.35rem;
    display: grid;
    gap: 0.7rem;
  }
  .track__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.6rem;
    color: var(--ink-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .track__tick {
    margin-top: 0.3rem;
    color: var(--brand-ink);
  }
  .track__best {
    margin-top: 1.35rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    color: var(--ink-subtle);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .track__best strong {
    color: var(--ink);
    font-weight: 600;
  }
  .track__link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--brand-ink);
    text-decoration: none;
  }
  .track__link:hover {
    text-decoration: underline;
  }

  @media (min-width: 760px) {
    .tracks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
