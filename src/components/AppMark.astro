---
/**
 * Stand-in app icon for entries whose CMS `icon` field is empty (all seeded
 * apps today). Deterministic: the same slug always yields the same gradient
 * angle and motif, so a card never changes identity between requests.
 *
 * Deliberately abstract — it is decoration, not a depiction of the product's
 * real icon. When an editor uploads a real icon, callers render that instead.
 */
import { hashString } from "../lib/hash";

interface Props {
  /** Stable seed — pass the entry slug. */
  seed: string;
  size?: number;
  /** Ground the glyph sits on; `brand` is the default miso orange. */
  tone?: "brand" | "peach" | "seaweed" | "tofu";
  class?: string;
}

const { seed, size = 56, tone = "brand", class: className } = Astro.props;

const MOTIFS = ["bars", "arc", "rings", "wave"] as const;
const hash = hashString(seed);
const motif = MOTIFS[hash % MOTIFS.length];
const angle = 110 + (hash % 7) * 18;
const radius = Math.round(size * 0.28);
---

<span
  class:list={["mark", `mark--${tone}`, className]}
  style={`--mark-size:${size}px;--mark-angle:${angle}deg;--mark-radius:${radius}px`}
  aria-hidden="true"
>
  <svg viewBox="0 0 48 48" class="mark__glyph" focusable="false">
    {
      motif === "bars" && (
        <>
          <rect x="11" y="26" width="5" height="12" rx="2.5" />
          <rect x="21.5" y="18" width="5" height="20" rx="2.5" />
          <rect x="32" y="12" width="5" height="26" rx="2.5" />
        </>
      )
    }
    {
      motif === "arc" && (
        <>
          <path d="M13 34a11 11 0 0 1 22 0" fill="none" stroke-width="4.5" stroke-linecap="round" />
          <circle cx="35" cy="14" r="4" />
        </>
      )
    }
    {
      motif === "rings" && (
        <>
          <circle cx="24" cy="24" r="12" fill="none" stroke-width="4" />
          <circle cx="24" cy="24" r="4" />
        </>
      )
    }
    {
      motif === "wave" && (
        <path
          d="M10 30c4.5-7 8-7 12.5 0s8 7 12.5 0"
          fill="none"
          stroke-width="4.5"
          stroke-linecap="round"
        />
      )
    }
  </svg>
</span>

<style>
  .mark {
    display: grid;
    place-items: center;
    width: var(--mark-size);
    height: var(--mark-size);
    flex: none;
    border-radius: var(--mark-radius);
    background: linear-gradient(var(--mark-angle), var(--brand), var(--brand-hover));
    color: var(--brand-fg);
  }
  .mark--peach {
    background: var(--peach);
    color: var(--peach-ink);
  }
  .mark--seaweed {
    background: var(--seaweed);
    color: var(--seaweed-accent);
  }
  .mark--tofu {
    background: var(--tofu);
    color: var(--brand);
  }
  .mark__glyph {
    width: 58%;
    height: 58%;
    fill: currentColor;
    stroke: currentColor;
  }
</style>
