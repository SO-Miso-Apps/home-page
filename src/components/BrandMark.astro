---
interface Props {
  /** Rendered square size in px. */
  size?: number;
  /** Show the "Miso Apps" wordmark next to the mark. */
  wordmark?: boolean;
  class?: string;
}

const { size = 26, wordmark = true, class: className } = Astro.props;
---

<span class:list={["brand", className]}>
  <svg
    class="brand__mark"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    aria-hidden="true"
    focusable="false"
  >
    <path
      class="brand__rim"
      d="M3 6.4h18a1.6 1.6 0 0 1 1.6 1.6v.6a1.6 1.6 0 0 1-1.6 1.6H3A1.6 1.6 0 0 1 1.4 8.6V8A1.6 1.6 0 0 1 3 6.4Z"
    />
    <path
      class="brand__bowl"
      d="M3.9 11.6h16.2c-.5 5.4-3.9 9.4-8.1 9.4s-7.6-4-8.1-9.4Z"
    />
    <path
      class="brand__steam"
      d="M12.4 1.6c1.5 1.4 1.8 2.9.8 4.1"
      fill="none"
      stroke-width="1.7"
      stroke-linecap="round"
    />
  </svg>
  {wordmark && <span class="brand__word">Miso<span class="brand__word-dim"> Apps</span></span>}
</span>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--ink);
  }
  .brand__mark {
    display: block;
    flex: none;
  }
  .brand__rim {
    fill: var(--ink);
  }
  .brand__bowl {
    fill: var(--brand);
  }
  .brand__steam {
    stroke: var(--brand);
    opacity: 0.75;
  }
  .brand__word {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .brand__word-dim {
    font-weight: 500;
    color: var(--ink-muted);
  }
</style>
