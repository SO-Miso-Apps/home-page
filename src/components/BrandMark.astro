---
interface Props {
  /** Rendered size of the blob in px. */
  size?: number;
  /** Show the "Miso Apps" wordmark next to the mark. */
  wordmark?: boolean;
  class?: string;
}

const { size = 30, wordmark = true, class: className } = Astro.props;
---

<span class:list={["brand", className]}>
  <span class="brand__mark" style={`--size: ${size}px`} aria-hidden="true"></span>
  {wordmark && <span class="brand__word">Miso Apps</span>}
</span>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--ink);
  }
  /* A drop of miso: slightly heavier at the bottom, never a perfect circle. */
  .brand__mark {
    display: block;
    flex: none;
    width: var(--size);
    height: var(--size);
    border-radius: var(--r-blob);
    background: var(--brand);
  }
  .brand__word {
    font-family: var(--font-display);
    font-size: 1.3125rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1;
  }
</style>
