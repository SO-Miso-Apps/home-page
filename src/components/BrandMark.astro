---
interface Props {
  /** Rendered size of the mark in px. */
  size?: number;
  /** Show the "Miso Apps" wordmark next to the mark. */
  wordmark?: boolean;
  class?: string;
}

const { size = 30, wordmark = true, class: className } = Astro.props;
---

<span class:list={["brand", className]}>
  <svg
    class="brand__mark"
    width={size}
    height={size}
    viewBox="0 0 32 32"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M4 16.5h24a12 12 0 0 1-24 0Z" fill="currentColor" />
    <path
      d="M10 13.5v-3.25a3 3 0 0 1 6 0v3.25M16 10.25a3 3 0 0 1 6 0v3.25"
      fill="none"
      stroke="currentColor"
      stroke-width="2.6"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
  {wordmark && <span class="brand__word">Miso Apps</span>}
</span>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--ink);
  }
  /* A bowl of miso with two curls of steam that read as an "m". */
  .brand__mark {
    display: block;
    flex: none;
    color: var(--brand);
  }
  .brand__word {
    font-family: var(--font-display);
    font-size: 1.3125rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1;
  }
</style>
