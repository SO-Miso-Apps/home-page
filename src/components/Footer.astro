---
import { getMenu } from "emdash";
import BrandMark from "./BrandMark.astro";
import { getLang, localizeHref } from "../i18n";
import { CONTACT_EMAIL, CONTACT_PHONE, CONTACT_PHONE_HREF } from "../site";

const lang = getLang(Astro.locals);
const copy = {
  en: {
    home: "Miso Apps home",
    blurb: "We design and customize Shopify themes, and build small apps that take the busywork off a store.",
    nav: "Footer navigation",
    company: "Company",
    contact: "Contact",
    feeds: "Feeds",
    rights: "All rights reserved.",
    origin: "Made in Hanoi, Vietnam",
  },
  vi: {
    home: "Miso Apps – trang chủ",
    blurb: "Chúng tôi thiết kế, tùy chỉnh theme Shopify và làm các app nhỏ giúp cửa hàng bớt việc vặt.",
    nav: "Liên kết cuối trang",
    company: "Công ty",
    contact: "Liên hệ",
    feeds: "Theo dõi",
    rights: "Bảo lưu mọi quyền.",
    origin: "Làm tại Hà Nội, Việt Nam",
  },
}[lang];

const menu = await getMenu("footer", { locale: lang });
// Contact details come from site.ts rather than the footer-contact widget
// areas, so the email and phone are links and match the rest of the site.
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a class="footer__brand-link" href={localizeHref("/", lang)} aria-label={copy.home}>
          <BrandMark size={30} />
        </a>
        <p>{copy.blurb}</p>
      </div>

      {
        menu?.items.length ? (
          <nav class="footer__col" aria-label={copy.nav}>
            <h2 class="footer__title">{copy.company}</h2>
            <ul class="footer__list">
              {menu.items.map((item) => (
                <li>
                  <a
                    href={localizeHref(item.url, lang)}
                    target={item.target}
                    rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ) : null
      }

      <div class="footer__col">
        <h2 class="footer__title">{copy.contact}</h2>
        <ul class="footer__list">
          <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
          <li><a class="num" href={CONTACT_PHONE_HREF}>{CONTACT_PHONE}</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h2 class="footer__title">{copy.feeds}</h2>
        <ul class="footer__list">
          <li><a href="/rss.xml">RSS</a></li>
          <li><a href="/sitemap.xml">Sitemap</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__legal">
      <p>© {year} Miso Apps. {copy.rights}</p>
      <p class="footer__origin">
        <span class="footer__blob" aria-hidden="true"></span>
        {copy.origin}
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin: clamp(4rem, 9vw, 7rem) clamp(0.5rem, 1.5vw, 1.25rem) 0;
    border-radius: var(--r-2xl) var(--r-2xl) 0 0;
    background: var(--tofu);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 2.2fr) repeat(3, minmax(0, 1fr));
    gap: 2.5rem 2rem;
    padding-block: clamp(3rem, 6vw, 4.5rem) clamp(2.5rem, 5vw, 3.5rem);
  }

  .footer__brand {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .footer__brand-link {
    justify-self: start;
    text-decoration: none;
  }

  .footer__brand p {
    color: var(--ink-muted);
    max-width: 36ch;
  }

  .footer__col {
    display: grid;
    gap: 0.85rem;
    align-content: start;
  }

  .footer__title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-subtle);
  }

  .footer__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.25rem;
  }

  .footer__list a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    color: var(--ink);
    font-size: 0.9375rem;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color var(--dur-2) var(--ease-quart);
  }

  .footer__list a:hover {
    color: var(--brand-ink);
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 1.25rem 1.5rem;
    border-top: 1px solid var(--tofu-line);
    color: var(--ink-subtle);
    font-size: 0.875rem;
  }

  .footer__origin {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer__blob {
    width: 9px;
    height: 9px;
    border-radius: var(--r-blob);
    background: var(--brand);
    flex: none;
  }

  @media (max-width: 959px) {
    .footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 559px) {
    .footer__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
