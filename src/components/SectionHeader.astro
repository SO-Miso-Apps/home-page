---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: "start" | "center";
  id?: string;
  class?: string;
}

const { eyebrow, title, lead, align = "start", id, class: className } = Astro.props;
---

<header class:list={["head", `head--${align}`, className]} data-reveal>
  {
    eyebrow && (
      <span class="eyebrow">
        <span class="eyebrow__dot" />
        {eyebrow}
      </span>
    )
  }
  <h2 id={id}>{title}</h2>
  {lead && <p class="lede">{lead}</p>}
</header>

<style>
  .head {
    display: grid;
    gap: 0.75rem;
    max-width: 62ch;
  }
  .head h2 {
    font-size: var(--step-4);
  }
  .head--center {
    justify-items: center;
    text-align: center;
    margin-inline: auto;
  }
  .head p {
    margin: 0;
  }
</style>
