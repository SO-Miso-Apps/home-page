---
interface Props {
  title: string;
  body?: string;
  primary: { label: string; href: string; external?: boolean };
  secondary?: { label: string; href: string; external?: boolean };
  eyebrow?: string;
  /**
   * Set the demo store under the copy: a browser window rising from the panel's
   * bottom edge, flanked by two phone screens on wide screens.
   */
  showcase?: boolean;
}

const { title, body, primary, secondary, eyebrow, showcase = false } = Astro.props;
---

<section class="section section--tight">
  <div class="container">
    <div class:list={["cta tone-seaweed", { "cta--showcase": showcase }]} data-reveal>
      {
        showcase && (
          <div class="cta__phones" aria-hidden="true">
            <span class="cta__phone cta__phone--left">
              <img src="/demo/mobile-collection.webp" width="660" height="1428" alt="" loading="lazy" decoding="async" />
            </span>
            <span class="cta__phone cta__phone--right">
              <img src="/demo/mobile-cart.webp" width="660" height="1428" alt="" loading="lazy" decoding="async" />
            </span>
          </div>
        )
      }
      {eyebrow && <span class="cta__eyebrow">{eyebrow}</span>}
      <h2>{title}</h2>
      {body && <p class="cta__body">{body}</p>}
      <div class="cta__actions">
        <a
          class="btn btn--brand btn--lg"
          href={primary.href}
          target={primary.external ? "_blank" : undefined}
          rel={primary.external ? "noopener noreferrer" : undefined}
        >
          {primary.label}
          <svg class="btn__arrow" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
            <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        {
          secondary && (
            <a
              class="btn btn--lg cta__secondary"
              href={secondary.href}
              target={secondary.external ? "_blank" : undefined}
              rel={secondary.external ? "noopener noreferrer" : undefined}
            >
              {secondary.label}
            </a>
          )
        }
      </div>
      {
        showcase && (
          <div class="cta__window" aria-hidden="true">
            <span class="cta__window-bar">
              <i />
              <i />
              <i />
            </span>
            <img src="/demo/store-home.webp" width="1440" height="900" alt="" loading="lazy" decoding="async" />
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    padding: clamp(2.25rem, 6vw, 5rem) clamp(1.25rem, 5vw, 4rem);
    border-radius: var(--r-2xl);
  }
  .cta__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--seaweed-accent);
  }
  .cta h2 {
    font-size: var(--step-5);
    max-width: 16ch;
  }
  .cta__body {
    color: var(--seaweed-muted);
    font-size: var(--step-1);
    line-height: 1.7;
    max-width: 52ch;
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .cta__secondary {
    background: transparent;
    color: var(--seaweed-ink);
    border-color: color-mix(in oklab, var(--seaweed-ink) 40%, transparent);
  }
  .cta__secondary:hover {
    border-color: var(--seaweed-ink);
  }

  /* The showcase: the demo store's home page in a browser window, rising from
     the bottom edge, which crops it. Decorative, so it carries no alt text. */
  .cta--showcase {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-bottom: 0;
  }
  .cta--showcase > :not(.cta__phones) {
    position: relative;
    z-index: 1;
  }
  .cta__window {
    width: min(100%, 860px);
    height: clamp(170px, 30vw, 330px);
    margin-top: clamp(1rem, 3vw, 2rem);
    overflow: hidden;
    border-radius: var(--r-md) var(--r-md) 0 0;
    background: #faf8f4;
    box-shadow: 0 -12px 50px -18px rgba(0, 0, 0, 0.45);
  }
  .cta__window-bar {
    display: flex;
    gap: 6px;
    padding: 10px 14px;
    background: #ece8e1;
  }
  .cta__window-bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #cfc8bd;
  }
  .cta__window img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Phones tilt in from the sides, only where there is room beside the
     centred copy. */
  .cta__phones {
    display: none;
  }
  @media (min-width: 1100px) {
    .cta__phones {
      display: block;
      position: absolute;
      inset: 0;
      pointer-events: none;
    }
    .cta__phone {
      position: absolute;
      top: 3.5rem;
      width: clamp(150px, 14vw, 190px);
      padding: 6px;
      border-radius: 1.9rem;
      background: #1d1a17;
      box-shadow: 0 30px 60px -24px rgba(0, 0, 0, 0.55);
    }
    .cta__phone img {
      display: block;
      width: 100%;
      height: auto;
      border-radius: 1.5rem;
    }
    .cta__phone--left {
      left: clamp(1.5rem, 4vw, 4rem);
      transform: rotate(-7deg);
    }
    .cta__phone--right {
      right: clamp(1.5rem, 4vw, 4rem);
      top: 5.5rem;
      transform: rotate(6deg);
    }
  }
</style>
