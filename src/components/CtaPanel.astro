---
interface Props {
  title: string;
  body?: string;
  primary: { label: string; href: string; external?: boolean };
  secondary?: { label: string; href: string; external?: boolean };
  eyebrow?: string;
}

const { title, body, primary, secondary, eyebrow } = Astro.props;
---

<section class="section section--tight">
  <div class="container">
    <div class="cta tone-seaweed" data-reveal>
      {eyebrow && <span class="cta__eyebrow">{eyebrow}</span>}
      <h2>{title}</h2>
      {body && <p class="cta__body">{body}</p>}
      <div class="cta__actions">
        <a
          class="btn btn--brand btn--lg"
          href={primary.href}
          target={primary.external ? "_blank" : undefined}
          rel={primary.external ? "noopener noreferrer" : undefined}
        >
          {primary.label}
          <svg class="btn__arrow" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
            <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        {
          secondary && (
            <a
              class="btn btn--lg cta__secondary"
              href={secondary.href}
              target={secondary.external ? "_blank" : undefined}
              rel={secondary.external ? "noopener noreferrer" : undefined}
            >
              {secondary.label}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    padding: clamp(2.25rem, 6vw, 5rem) clamp(1.25rem, 5vw, 4rem);
    border-radius: var(--r-2xl);
  }
  .cta__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--seaweed-accent);
  }
  .cta h2 {
    font-size: var(--step-5);
    max-width: 16ch;
  }
  .cta__body {
    color: var(--seaweed-muted);
    font-size: var(--step-1);
    line-height: 1.7;
    max-width: 52ch;
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .cta__secondary {
    background: transparent;
    color: var(--seaweed-ink);
    border-color: color-mix(in oklab, var(--seaweed-ink) 40%, transparent);
  }
  .cta__secondary:hover {
    border-color: var(--seaweed-ink);
  }
</style>
