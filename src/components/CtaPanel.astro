---
import CoverArt from "./CoverArt.astro";

interface Props {
  title: string;
  body?: string;
  primary: { label: string; href: string; external?: boolean };
  secondary?: { label: string; href: string; external?: boolean };
  /** Seeds the decorative wash so panels differ across pages. */
  seed?: string;
  eyebrow?: string;
}

const { title, body, primary, secondary, seed, eyebrow } = Astro.props;
---

<section class="section section--tight">
  <div class="container">
    <div class="cta" data-reveal>
      <div class="cta__art" aria-hidden="true">
        <CoverArt seed={seed ?? title} />
      </div>
      <div class="cta__body">
        {
          eyebrow && (
            <span class="eyebrow">
              <span class="eyebrow__dot" />
              {eyebrow}
            </span>
          )
        }
        <h2>{title}</h2>
        {body && <p>{body}</p>}
      </div>
      <div class="cta__actions">
        <a
          class="btn btn--brand btn--lg"
          href={primary.href}
          target={primary.external ? "_blank" : undefined}
          rel={primary.external ? "noopener noreferrer" : undefined}
        >
          {primary.label}
          <svg class="btn__arrow" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" focusable="false">
            <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        {
          secondary && (
            <a
              class="btn btn--ghost btn--lg"
              href={secondary.href}
              target={secondary.external ? "_blank" : undefined}
              rel={secondary.external ? "noopener noreferrer" : undefined}
            >
              {secondary.label}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    display: grid;
    gap: 1.75rem;
    overflow: hidden;
    padding: clamp(2rem, 5vw, 3.25rem);
    border: 1px solid var(--line);
    border-radius: var(--r-2xl);
    background: var(--surface);
    box-shadow: var(--shadow-2);
  }
  .cta__art {
    position: absolute;
    inset: 0;
    opacity: 0.75;
  }
  .cta__body {
    position: relative;
    display: grid;
    gap: 0.75rem;
    max-width: 46ch;
  }
  .cta__body h2 {
    font-size: var(--step-3);
  }
  .cta__body p {
    color: var(--ink-muted);
    font-size: var(--step-1);
  }
  .cta__actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (min-width: 880px) {
    .cta {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 2.5rem;
    }
    .cta__actions {
      flex-wrap: nowrap;
    }
  }
</style>
