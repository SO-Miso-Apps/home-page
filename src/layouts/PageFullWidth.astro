---
import type { ContentEntry } from "emdash";
import type { Page } from "../../emdash-env";
import { PortableText } from "emdash/ui";
import Base from "./Base.astro";

interface Props {
  page: ContentEntry<Page>;
  /** Resolved SEO title (SEO panel || seo_title || content title); falls back to the content title. */
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  robots?: string;
}

const { page, title, description, image, canonical, robots } = Astro.props;
const data = page.data;
---

<Base title={title ?? data.title} description={description} image={image} canonical={canonical} robots={robots}>
  <article class="page">
    <header class="container page__head">
      <span class="eyebrow">
        <span class="eyebrow__dot" />
        Miso Apps
      </span>
      <h1>{data.title}</h1>
    </header>
    <div class="container prose" data-reveal>
      <PortableText value={data.content} />
    </div>
  </article>
</Base>

<style>
  .page {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 2rem;
  }
  .page__head {
    display: grid;
    gap: 0.75rem;
    padding-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }
  h1 {
    font-size: var(--step-5);
    letter-spacing: -0.035em;
  }
</style>
