---
import "../styles/global.css";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import { LANG_NAMES, LANG_SCRIPT, LANGS, getLang, localizeHref, splitLang } from "../i18n";
import { SITE_DESCRIPTION, SITE_DESCRIPTION_VI, SITE_TITLE } from "../site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  robots?: string;
}

const lang = getLang(Astro.locals);
const copy = {
  en: { description: SITE_DESCRIPTION, studio: "Shopify theme design and apps", skip: "Skip to content" },
  vi: { description: SITE_DESCRIPTION_VI, studio: "Thiết kế theme và app Shopify", skip: "Chuyển đến nội dung chính" },
}[lang];

const {
  title,
  description = copy.description,
  image,
  canonical,
  robots,
} = Astro.props;

const siteName = SITE_TITLE;
const fullTitle = title ? `${title} — ${siteName}` : `${siteName} — ${copy.studio}`;

const origin = Astro.site ?? Astro.url.origin;
// Pages hand over a canonical built from Astro.url, which middleware has
// already stripped of /vi; re-point it at this page's language. An editor's
// canonical to another host is left alone.
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, origin);
const path = splitLang(canonicalUrl.pathname).path;
const canonicalHref =
  canonicalUrl.origin === new URL(origin).origin
    ? new URL(localizeHref(path, lang), origin).toString()
    : canonicalUrl.toString();
// One alternate per language for the same page — the language switcher and
// the head script both read these, so they are the only map of the site.
const alternates = LANGS.map((code) => ({ code, href: new URL(localizeHref(path, code), origin).toString() }));
---

<!doctype html>
<html lang={LANG_NAMES[lang].htmlLang} data-lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="color-scheme" content="light dark" />
    {/*
      Resolve the theme before first paint. Storing the attribute here keeps CSS
      free of a duplicated prefers-color-scheme block, and prevents the flash of
      light theme a post-paint script would cause.
    */}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let stored = null;
        try {
          stored = localStorage.getItem("miso-theme");
        } catch {
          /* private mode / storage disabled — fall back to the system setting */
        }
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = stored === "light" || stored === "dark" ? stored : prefersDark ? "dark" : "light";
        root.dataset.theme = theme;
        root.dataset.themeChoice = stored ?? "system";
      })();
    </script>
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.code} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    {/* After the alternates: the script looks its target up among them. */}
    {robots?.includes("noindex") ? null : <script is:inline set:html={LANG_SCRIPT} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalHref} />
    <link rel="alternate" type="application/rss+xml" title="Miso Apps Blog" href="/rss.xml" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={LANG_NAMES[lang].ogLocale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={new URL(image, origin)} />}
    <meta property="og:url" content={canonicalHref} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#fcfcfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#151412" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,500&family=IBM+Plex+Mono:wght@400;500&family=Onest:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script>
      import "../scripts/motion";
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{copy.skip}</a>
    <Navigation />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
