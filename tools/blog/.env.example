# Production run
EMDASH_SITE_URL=https://misoapps.com
# PAT from https://misoapps.com/_emdash/admin → API tokens, scopes content:write + media:write
EMDASH_API_TOKEN=

# --dry-run writes to the local dev server instead (astro dev / wrangler dev)
EMDASH_DEV_URL=http://localhost:4399
# A token minted against the local D1; never the production token
EMDASH_DEV_TOKEN=

# Models
BLOG_WRITER_MODEL=
BLOG_CRITIC_MODEL=opencode-go/deepseek-v4.1-flash
BLOG_MAX_ATTEMPTS=3
